---
import BuildBadge from "../components/BuildBadge.astro";

interface Props {
    title?: string;
    description?: string;
}
const { title = "PulseBoard", description } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <style>
            body,
            html {
                margin: 0;
                width: 100dvw;
                height: 100dvh;
            }
        </style>
    </head>
    <body>
        <slot />
        <BuildBadge />
    </body>
</html>

<script>
    // Carbon's text input does not expose a CSS part yet. Expose just its
    // native input so our shared radius can be styled without clipping the
    // label, helper text, password toggle tooltip, or focus outline.
    const fields = document.querySelectorAll("cds-text-input");
    if (fields.length) {
        customElements.whenDefined("cds-text-input").then(async () => {
            for (const field of fields) {
                await (
                    field as HTMLElement & { updateComplete: Promise<boolean> }
                ).updateComplete;
                field.shadowRoot?.querySelector("input")?.part.add("input");
            }
        });
    }
</script>
