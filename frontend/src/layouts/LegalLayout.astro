---
import "../styles/carbon.scss";
import HtmlTemplate from "./HtmlTemplate.astro";
import { lastUpdated } from "../lib/legal";

interface Props {
    title: string;
    description: string;
    lang: "en" | "pl";
    // the same document in the other language
    alternate: string;
}
const { title, description, lang, alternate } = Astro.props;
const pl = lang === "pl";
---

<HtmlTemplate
    title={`${title} · PulseBoard`}
    description={description}
    lang={lang}
>
    <div class="legal">
        <header>
            <a class="brand" href="/">
                PulseBoard
            </a>
            <a
                href={alternate}
                hreflang={pl ? "en" : "pl"}
                lang={pl ? "en" : "pl"}
            >
                {pl ? "English version" : "Wersja polska"}
            </a>
        </header>
        <article>
            <h1>{title}</h1>
            <p class="updated">
                {pl ? "Ostatnia aktualizacja: " : "Last updated: "}
                <time datetime={lastUpdated.iso}>
                    {pl ? lastUpdated.pl : lastUpdated.en}
                </time>
            </p>
            <slot />
        </article>
    </div>
</HtmlTemplate>

<style>
    :global(html) {
        background: var(--cds-background, #fff);
    }
    :global(body) {
        width: 100%;
        height: auto;
        color: var(--cds-text-primary, #161616);
    }
    .legal {
        box-sizing: border-box;
        width: 100%;
        padding: 1.5rem 40px 4rem;
    }
    @media (max-width: 600px) {
        .legal {
            padding-inline: 18px;
        }
    }
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding-block-end: 1.5rem;
        border-block-end: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 0.875rem;
    }
    a {
        color: var(--cds-link-primary, #0f62fe);
    }
    .brand {
        font-size: 1rem;
        font-weight: 600;
        color: inherit;
        text-decoration: none;
    }
    h1 {
        margin: 2.5rem 0 0.5rem;
        font-size: 2.25rem;
        font-weight: 400;
        line-height: 1.25;
    }
    .updated {
        margin: 0 0 2.5rem;
        font-size: 0.875rem;
        color: var(--cds-text-secondary, #525252);
    }
    article :global(h2) {
        margin: 2.5rem 0 0.75rem;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.4;
    }
    article :global(h3) {
        margin: 1.5rem 0 0.5rem;
        font-size: 1rem;
        font-weight: 600;
    }
    article :global(p),
    article :global(li) {
        font-size: 1rem;
        line-height: 1.65;
        letter-spacing: 0;
    }
    article :global(p) {
        margin: 0 0 1rem;
    }
    article :global(ul),
    article :global(ol) {
        margin: 0 0 1rem;
        padding-inline-start: 1.5rem;
    }
    article :global(ul) {
        list-style: disc;
    }
    article :global(ol) {
        list-style: decimal;
    }
    article :global(li + li) {
        margin-block-start: 0.375rem;
    }
    article :global(strong) {
        font-weight: 600;
    }
    article :global(blockquote) {
        margin: 0 0 1rem;
        padding: 1rem 1.25rem;
        background: var(--cds-layer-01, #f4f4f4);
        border-inline-start: 3px solid var(--cds-border-strong-01, #8d8d8d);
    }
    article :global(blockquote p:last-child) {
        margin: 0;
    }
</style>
