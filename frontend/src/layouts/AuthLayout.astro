---
import "../styles/carbon.scss";
import HtmlTemplate from "./HtmlTemplate.astro";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<HtmlTemplate title={`${title} · PulseBoard`}>
    <main>
        <cds-link class="home" href="/">
            ← Back to home
        </cds-link>
        <h1>PulseBoard</h1>
        <slot />
    </main>
</HtmlTemplate>

<style>
    :global(body) {
        display: grid;
        place-items: center;
    }
    main {
        box-sizing: border-box;
        width: 100%;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 10px 10px;
        box-shadow: 0px 0px 4px 2px rgba(0, 0, 0, 0.25);
    }
    main :global(p),
    main :global(cds-link) {
        font-size: 0.875rem;
        line-height: 1.5;
        font-family: inherit;
    }
    .home {
        align-self: flex-start;
    }
    /* main's flex layout would otherwise override the hidden attribute */
    main :global([hidden]) {
        display: none;
    }
    main :global(form) {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
</style>

<script>
    import "@carbon/web-components/es/components/button/index.js";
    import "@carbon/web-components/es/components/text-input/index.js";
    import "@carbon/web-components/es/components/notification/index.js";
    import "@carbon/web-components/es/components/link/index.js";
</script>
