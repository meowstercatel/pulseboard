---
import UsageChart from "./UsageChart.astro";

const cpu = [
    31, 35, 28, 40, 44, 39, 52, 61, 58, 47, 43, 38, 41, 49, 55, 50, 46, 42, 37,
    40, 45, 48, 44, 42,
];
const memory = [
    64, 65, 65, 66, 68, 67, 69, 71, 72, 70, 70, 69, 70, 71, 72, 73, 72, 71, 71,
    70, 71, 72, 71, 71,
];
const disks = [
    { name: "/", used: "38.2 / 98 GiB", percent: 39 },
    { name: "/var", used: "171.5 / 196 GiB", percent: 88 },
];
const services = [
    { name: "nginx.service", active: true },
    { name: "postgresql.service", active: true },
    { name: "app-worker.service", active: false },
];
---

<div class="dashboard">
    <div class="preview-header">
        <span>PulseBoard / Overview</span>
        <cds-tag type="gray" size="sm">
            Sample data
        </cds-tag>
    </div>
    <div class="dashboard-content">
        <div class="server-heading">
            <div>
                <h3>
                    web-01{" "}
                    <cds-tag type="green" size="md">
                        Online
                    </cds-tag>
                </h3>
                <p class="meta">Ubuntu 24.04.1 LTS · 10.0.0.12</p>
            </div>
            <p class="meta">Uptime: 23d 4h 17m</p>
        </div>
        <div class="metrics">
            <cds-tile>
                <p class="label">CPU</p>
                <p class="value">
                    42<span>%</span>
                </p>
                <cds-progress-bar
                    label="CPU usage"
                    hide-label
                    value="42"
                    status="active"
                ></cds-progress-bar>
                <p class="meta">8 cores · AMD EPYC 7763</p>
            </cds-tile>
            <cds-tile>
                <p class="label">Memory</p>
                <p class="value">
                    71<span>%</span>
                </p>
                <cds-progress-bar
                    label="Memory usage"
                    hide-label
                    value="71"
                    status="active"
                ></cds-progress-bar>
                <p class="meta">11.4 / 16 GiB</p>
            </cds-tile>
            <cds-tile>
                <p class="label">Network (eth0)</p>
                <p class="value network">
                    ↓ 12.4 MB/s
                    <br />↑ 3.1 MB/s
                </p>
                <p class="meta">Incoming / outgoing traffic</p>
            </cds-tile>
        </div>
        <div class="charts">
            <cds-tile>
                <UsageChart title="CPU usage · last 2 hours" series={cpu} />
            </cds-tile>
            <cds-tile>
                <UsageChart
                    title="Memory usage · last 2 hours"
                    series={memory}
                />
            </cds-tile>
        </div>
        <div class="details">
            <cds-tile>
                <h4>Storage</h4>
                <div class="disks">
                    {disks.map((disk) => (
                        <cds-progress-bar
                            label={disk.name}
                            helper-text={`${disk.used} · ${disk.percent}%`}
                            value={disk.percent}
                            status="active"
                        ></cds-progress-bar>
                    ))}
                </div>
            </cds-tile>
            <cds-tile>
                <h4>Services</h4>
                <ul class="services">
                    {services.map((service) => (
                        <li>
                            <span>{service.name}</span>
                            <cds-tag
                                type={service.active ? "green" : "red"}
                                size="sm"
                            >
                                {service.active ? "active" : "failed"}
                            </cds-tag>
                        </li>
                    ))}
                </ul>
            </cds-tile>
        </div>
    </div>
</div>

<style>
    .dashboard {
        background: var(--cds-background, #fff);
        border: 1px solid var(--cds-border-subtle, #e0e0e0);
        text-align: left;
    }
    .preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 0.875rem;
    }
    .dashboard-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem;
    }
    .server-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }
    h3 {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        margin: 0 0 0.25rem;
    }
    h4,
    .label {
        font-size: 0.875rem;
        font-weight: 600;
        margin: 0;
    }
    p {
        margin: 0;
    }
    .meta {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.75rem;
        line-height: 1.5;
    }
    .metrics,
    .charts,
    .details {
        display: grid;
        gap: 1rem;
    }
    .metrics {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .charts,
    .details {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    cds-tile {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }
    .value {
        font-size: 2.25rem;
        line-height: 1.2;
    }
    .value span {
        font-size: 1rem;
        margin-left: 0.125rem;
    }
    .network {
        font-size: 1.25rem;
    }
    .charts :global(.plot) {
        height: 8rem;
    }
    .disks {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-top: 0.75rem;
    }
    .services {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .services li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 0.875rem;
    }
    @media (max-width: 700px) {
        .dashboard-content {
            padding: 1rem;
        }
        .preview-header {
            padding-inline: 1rem;
        }
        .charts,
        .details {
            grid-template-columns: 1fr;
        }
        .metrics {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    import "@carbon/web-components/es/components/tile/index.js";
    import "@carbon/web-components/es/components/tag/index.js";
    import "@carbon/web-components/es/components/progress-bar/index.js";
</script>
