---
// Shown only for providers the server has credentials for. Both buttons take
// up their space while the list loads, so the page doesn't jump.
---

<div class="oauth" data-loading>
    <cds-button
        kind="tertiary"
        href="/api/auth/oauth/google"
        data-provider="google"
    >
        Continue with Google
    </cds-button>
    <cds-button
        kind="tertiary"
        href="/api/auth/oauth/facebook"
        data-provider="facebook"
    >
        Continue with Facebook
    </cds-button>
</div>

<style>
    .oauth {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .oauth[data-loading] {
        visibility: hidden;
    }
    /* Carbon's lg button height, held until its script defines cds-button */
    .oauth cds-button:not(:defined) {
        min-height: 3rem;
    }
    .oauth[hidden],
    .oauth [hidden] {
        display: none;
    }
</style>

<script>
    import { oauthProviders, safeNext } from "../lib/auth";

    const box = document.querySelector<HTMLElement>(".oauth")!;
    // come back to the page the user asked for, as the password login does
    const next = safeNext(new URLSearchParams(location.search).get("next"));

    oauthProviders().then((providers) => {
        for (const button of box.querySelectorAll<HTMLElement>(
            "[data-provider]",
        )) {
            const provider = button.dataset["provider"]!;
            button.hidden = !providers.includes(provider);
            if (next) {
                button.setAttribute(
                    "href",
                    `/api/auth/oauth/${provider}?${new URLSearchParams({ next })}`,
                );
            }
        }
        box.hidden = !providers.length;
        delete box.dataset["loading"];
    });
</script>
