---
// Line chart of a 0-100% metric for the landing preview, drawn like /history:
// the line breaks across gaps, which are shaded, and spikes are circled. Hover
// and keyboard inspection come from initUsageChart() in usageChart.ts.
import type { Gap } from "../lib/history";
import { utc } from "../lib/history";

interface Props {
    title: string;
    // Reading times in ms, ascending, and the reading at each
    times: number[];
    values: number[];
    gaps: Gap[];
    // Indices of readings inside a spike
    spikes?: number[];
}

const { title, times, values, gaps, spikes = [] } = Astro.props;

const W = 300;
const H = 100;
const start = times[0]!;
const span = times.at(-1)! - start;
const x = (t: number) => ((t - start) / span) * W;
const y = (v: number) => H - v;
// One polyline per run of readings with no gap inside it
const segments: string[] = [];
times.forEach((t, i) => {
    const point = `${x(t)},${y(values[i]!)}`;
    const broken =
        i === 0 || gaps.some((g) => g.start > times[i - 1]! && g.end <= t);
    if (broken) segments.push(point);
    else segments[segments.length - 1] += ` ${point}`;
});
const ticks = [0, 25, 50, 75, 100];
// The middle label goes on the reading nearest the middle of the span
const middle = times.reduce(
    (best, t, i) =>
        Math.abs(t - start - span / 2) <
        Math.abs(times[best]! - start - span / 2)
            ? i
            : best,
    0,
);
const xTicks = [0, middle, times.length - 1];
const pct = (t: number) => `${(x(t) / W) * 100}%`;
const hour = (t: number) => utc(t).slice(11);
const labels = times.map(
    (t, i) => `${utc(t)} UTC${spikes.includes(i) ? " · spike" : ""}`,
);
const last = values.at(-1)!;
---

<div
    class="usage-chart"
    data-times={JSON.stringify(times)}
    data-series={JSON.stringify(values)}
    data-labels={JSON.stringify(labels)}
>
    <p class="title">{title}</p>
    <div class="body">
        <div class="y-axis" aria-hidden="true">
            {ticks.map((t) => (
                <span style={`top: ${100 - t}%`}>{t}%</span>
            ))}
        </div>
        <div
            class="plot"
            tabindex="0"
            role="img"
            aria-label={`${title}. Use left and right arrow keys to inspect values.`}
        >
            <svg
                viewBox={`0 0 ${W} ${H}`}
                preserveAspectRatio="none"
                aria-hidden="true"
            >
                {ticks.map((t) => (
                    <line class="grid" x1="0" x2={W} y1={y(t)} y2={y(t)} />
                ))}
                {gaps.map((g) => (
                    <rect
                        class="band"
                        x={x(g.start)}
                        y="0"
                        width={x(g.end) - x(g.start)}
                        height={H}
                    />
                ))}
                {segments.map((points) => (
                    <polyline class="line" points={points} />
                ))}
            </svg>
            {spikes.map((i) => (
                <span
                    class="marker"
                    aria-hidden="true"
                    style={`left: ${pct(times[i]!)}; top: ${100 - values[i]!}%`}
                />
            ))}
            <span class="end-label" style={`top: ${100 - last}%`}>
                {last}%
            </span>
            <div class="crosshair" hidden></div>
            <div class="dot" hidden></div>
            <div class="tooltip" role="status" hidden>
                <strong class="tooltip-value"></strong>
                <span class="tooltip-label"></span>
            </div>
        </div>
    </div>
    <div class="x-axis" aria-hidden="true">
        {xTicks.map((i) => (
            <span style={`left: ${pct(times[i]!)}`}>{hour(times[i]!)}</span>
        ))}
    </div>
    <table class="sr-only">
        <caption>{title}</caption>
        <tr>
            <th>Time (UTC)</th>
            <th>Usage</th>
        </tr>
        {times.map((_, i) => (
            <tr>
                <td>{labels[i]}</td>
                <td>{values[i]} %</td>
            </tr>
        ))}
    </table>
</div>

<style>
    .usage-chart {
        --series: #0f62fe;
        --spike: #da1e28;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .title {
        font-weight: 600;
    }
    .body {
        display: flex;
        gap: 0.5rem;
    }
    .y-axis {
        position: relative;
        width: 2.25rem;
        flex-shrink: 0;
    }
    .y-axis span,
    .x-axis span {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
    }
    .y-axis span {
        position: absolute;
        right: 0;
        transform: translateY(-50%);
    }
    .plot {
        position: relative;
        flex: 1;
        height: 8rem;
        margin-inline-end: 2.5rem;
        cursor: crosshair;
        outline-offset: 4px;
    }
    svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    .grid {
        stroke: var(--cds-border-subtle, #e0e0e0);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    .band {
        fill: rgb(198 198 198 / 0.35);
    }
    .line {
        fill: none;
        stroke: var(--series);
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }
    .marker {
        position: absolute;
        width: 10px;
        height: 10px;
        box-sizing: border-box;
        border: 2px solid var(--spike);
        border-radius: 50%;
        background: var(--cds-layer-01, #f4f4f4);
        transform: translate(-50%, -50%);
        pointer-events: none;
    }
    .end-label {
        position: absolute;
        left: calc(100% + 0.5rem);
        transform: translateY(-50%);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--cds-text-primary, #161616);
    }
    .crosshair {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--cds-text-secondary, #525252);
        pointer-events: none;
    }
    .dot {
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--series);
        box-shadow: 0 0 0 2px var(--cds-layer-01, #f4f4f4);
        transform: translate(-50%, -50%);
        pointer-events: none;
    }
    .tooltip {
        position: absolute;
        top: 0;
        display: flex;
        flex-direction: column;
        padding: 0.375rem 0.625rem;
        background: var(--cds-background-inverse, #393939);
        color: var(--cds-text-inverse, #fff);
        font-size: 0.75rem;
        white-space: nowrap;
        pointer-events: none;
        z-index: 1;
    }
    .tooltip-value {
        font-size: 0.875rem;
    }
    [hidden] {
        display: none !important;
    }
    .x-axis {
        position: relative;
        height: 1rem;
        margin-inline: 2.75rem 2.5rem;
    }
    .x-axis span {
        position: absolute;
        transform: translateX(-50%);
    }
    .x-axis span:first-child {
        transform: none;
    }
    .x-axis span:last-child {
        transform: translateX(-100%);
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>

<script>
    import { whenVisible } from "../lib/whenVisible";

    // The tooltip code loads once a chart is about to scroll into view. Until
    // the visitor touches the demo, the crosshair moves along on its own.
    document.querySelectorAll<HTMLElement>(".usage-chart").forEach((chart) =>
        whenVisible(chart, () =>
            import("../lib/usageChart").then((m) => {
                const controls = m.initUsageChart(chart);
                if (controls)
                    m.autoplay(
                        chart,
                        controls,
                        chart.closest(".dashboard") ?? chart,
                    );
            }),
        ),
    );
</script>
