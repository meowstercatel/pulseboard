---
// Area chart for a 0-100% series with a hover/keyboard crosshair tooltip.
interface Props {
    title: string;
    series: number[];
    // Minutes between samples; the last sample is "now".
    interval?: number;
}

const { title, series, interval = 5 } = Astro.props;

const W = 300;
const H = 100;
const x = (i: number) => (i / (series.length - 1)) * W;
const y = (v: number) => H - v;
const line = series.map((v, i) => `${x(i)},${y(v)}`).join(" ");
const area = `0,${H} ${line} ${W},${H}`;
const ticks = [0, 25, 50, 75, 100];
const xTicks = [0, Math.round((series.length - 1) / 2), series.length - 1];
const ago = (i: number) => {
    const m = (series.length - 1 - i) * interval;
    if (m === 0) return "now";
    const h = Math.floor(m / 60);
    return `${h ? `${h}h ` : ""}${m % 60 ? `${m % 60}m ` : ""}ago`;
};
const last = series[series.length - 1];
---

<div
    class="usage-chart"
    data-series={JSON.stringify(series)}
    data-interval={interval}
>
    <p class="title">{title}</p>
    <div class="body">
        <div class="y-axis" aria-hidden="true">
            {ticks.map((t) => (
                <span style={`top: ${100 - t}%`}>{t}%</span>
            ))}
        </div>
        <div
            class="plot"
            tabindex="0"
            role="img"
            aria-label={`${title}. Use left and right arrow keys to inspect values.`}
        >
            <svg
                viewBox={`0 0 ${W} ${H}`}
                preserveAspectRatio="none"
                aria-hidden="true"
            >
                {ticks.map((t) => (
                    <line class="grid" x1="0" x2={W} y1={y(t)} y2={y(t)} />
                ))}
                <polygon class="area" points={area} />
                <polyline class="line" points={line} />
            </svg>
            <span class="end-label" style={`top: ${100 - last}%`}>
                {last}%
            </span>
            <div class="crosshair" hidden></div>
            <div class="dot" hidden></div>
            <div class="tooltip" role="status" hidden>
                <strong class="tooltip-value"></strong>
                <span class="tooltip-label"></span>
            </div>
        </div>
    </div>
    <div class="x-axis" aria-hidden="true">
        {xTicks.map((i) => (
            <span style={`left: ${(i / (series.length - 1)) * 100}%`}>
                {ago(i)}
            </span>
        ))}
    </div>
    <table class="sr-only">
        <caption>{title}</caption>
        <tr>
            <th>Time</th>
            <th>Usage</th>
        </tr>
        {series.map((v, i) => (
            <tr>
                <td>{ago(i)}</td>
                <td>{v}%</td>
            </tr>
        ))}
    </table>
</div>

<style>
    .usage-chart {
        --series: #0f62fe;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .title {
        font-weight: 600;
    }
    .body {
        display: flex;
        gap: 0.5rem;
    }
    .y-axis {
        position: relative;
        width: 2.25rem;
        flex-shrink: 0;
    }
    .y-axis span,
    .x-axis span {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
    }
    .y-axis span {
        position: absolute;
        right: 0;
        transform: translateY(-50%);
    }
    .plot {
        position: relative;
        flex: 1;
        height: 10rem;
        margin-inline-end: 2.5rem;
        cursor: crosshair;
        outline-offset: 4px;
    }
    svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    .grid {
        stroke: var(--cds-border-subtle, #e0e0e0);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    .area {
        fill: var(--series);
        opacity: 0.1;
    }
    .line {
        fill: none;
        stroke: var(--series);
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }
    .end-label {
        position: absolute;
        left: calc(100% + 0.5rem);
        transform: translateY(-50%);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--cds-text-primary, #161616);
    }
    .crosshair {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--cds-text-secondary, #525252);
        pointer-events: none;
    }
    .dot {
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--series);
        box-shadow: 0 0 0 2px var(--cds-layer-01, #f4f4f4);
        transform: translate(-50%, -50%);
        pointer-events: none;
    }
    .tooltip {
        position: absolute;
        top: 0;
        display: flex;
        flex-direction: column;
        padding: 0.375rem 0.625rem;
        background: var(--cds-background-inverse, #393939);
        color: var(--cds-text-inverse, #fff);
        font-size: 0.75rem;
        white-space: nowrap;
        pointer-events: none;
        z-index: 1;
    }
    .tooltip-value {
        font-size: 0.875rem;
    }
    [hidden] {
        display: none !important;
    }
    .x-axis {
        position: relative;
        height: 1rem;
        margin-inline: 2.75rem 2.5rem;
    }
    .x-axis span {
        position: absolute;
        transform: translateX(-50%);
    }
    .x-axis span:first-child {
        transform: none;
    }
    .x-axis span:last-child {
        transform: translateX(-100%);
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>

<script>
    import { whenVisible } from "../lib/whenVisible";

    // The tooltip code loads once a chart is about to scroll into view
    document
        .querySelectorAll<HTMLElement>(".usage-chart")
        .forEach((chart) =>
            whenVisible(chart, () =>
                import("../lib/usageChart").then((m) =>
                    m.initUsageChart(chart),
                ),
            ),
        );
</script>
