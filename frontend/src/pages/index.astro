---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
---

<HtmlTemplate>
    <main>
        <h1>PulseBoard</h1>
        <cds-text-input label="Email"></cds-text-input>
        <cds-text-input label="Password" type="password"></cds-text-input>
        <cds-button>login</cds-button>
    </main>
</HtmlTemplate>

<style>
    :global(body) {
        display: grid;
        place-items: center;
    }
    main {
        width: 100%;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 10px 10px;
        box-shadow: 0px 0px 4px 2px rgba(0, 0, 0, 0.25);
    }
</style>

<script>
    import "@carbon/web-components/es/components/button/index.js";
    import "@carbon/web-components/es/components/text-input/index.js";
</script>
