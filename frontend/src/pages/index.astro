---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
import DashboardPreview from "../components/DashboardPreview.astro";

const features = [
    {
        number: "01",
        title: "See resource pressure.",
        text: "CPU usage, memory consumption, and system load. Get the context you need to understand a busy server.",
        tag: "CPU / MEMORY / LOAD",
    },
    {
        number: "02",
        title: "Put spikes in context.",
        text: "Follow CPU and memory trends over time. See whether that jump is a passing moment or a pattern worth investigating.",
        tag: "USAGE HISTORY",
    },
    {
        number: "03",
        title: "Keep storage in sight.",
        text: "Check usage across mount points and see where space is getting tight, without losing the bigger picture.",
        tag: "DISKS / MOUNT POINTS",
    },
    {
        number: "04",
        title: "Check what’s running.",
        text: "Review service status and the processes consuming the most resources. Know where to look next.",
        tag: "SERVICES / PROCESSES",
    },
];
---

<HtmlTemplate
    title="PulseBoard — Your server’s pulse, at a glance"
    description="A clear view of Linux server health. Explore CPU, memory, storage, network, and services in the PulseBoard sample dashboard."
>
    <a class="skip-link" href="#main">
        Skip to content
    </a>
    <div class="site">
        <header class="header wrap">
            <a class="brand" href="/" aria-label="PulseBoard home">
                PulseBoard
            </a>
            <nav aria-label="Main navigation">
                <a class="nav-feature" href="#features">
                    Features
                </a>
                <div class="nav-account" data-auth="pending">
                    <div class="nav-guest">
                        <a href="/login">
                            Log in <span aria-hidden="true">↗</span>
                        </a>
                        <cds-button
                            class="nav-register"
                            kind="tertiary"
                            size="md"
                            href="/register"
                        >
                            Register{" "}
                            <span slot="icon" aria-hidden="true">
                                →
                            </span>
                        </cds-button>
                    </div>
                    <div class="nav-user">
                        <span class="nav-user-name" id="nav-user-name"></span>
                        <a href="/" id="nav-logout">
                            Log out
                        </a>
                        <cds-button
                            id="nav-dashboard"
                            kind="tertiary"
                            size="md"
                            href="/overview"
                        >
                            Go to dashboard{" "}
                            <span slot="icon" aria-hidden="true">
                                →
                            </span>
                        </cds-button>
                    </div>
                </div>
            </nav>
        </header>
        <main id="main">
            <section class="hero wrap" aria-labelledby="hero-title">
                <div class="hero-row">
                    <h1 id="hero-title">
                        Your server’s pulse,
                        <br />
                        <em>at a glance.</em>
                    </h1>
                    <div class="hero-copy">
                        <p>
                            CPU, memory, storage, network, and services—in one
                            clear dashboard. See what’s busy, what’s filling up,
                            and what needs a closer look.
                        </p>
                    </div>
                </div>
                <section id="demo" class="demo" aria-label="Dashboard preview">
                    <div class="demo-caption">
                        <span>
                            INTERACTIVE PREVIEW{" "}
                            <span aria-hidden="true">↓</span>
                        </span>
                    </div>
                    <DashboardPreview />
                </section>
            </section>
            <section
                class="features wrap"
                id="features"
                aria-labelledby="features-title"
            >
                <div class="section-heading">
                    <div>
                        <h2 id="features-title">
                            Know where
                            <br />
                            to look next.
                        </h2>
                    </div>
                    <p>
                        A focused overview for developers and people running
                        their own servers. The essentials, with room to look
                        closer.
                    </p>
                </div>
                <div class="feature-grid">
                    {features.map((feature) => (
                        <article>
                            <span class="number">
                                {feature.number}{" "}
                                <span aria-hidden="true">/</span>
                            </span>
                            <h3>{feature.title}</h3>
                            <p>{feature.text}</p>
                            <span class="feature-tag">{feature.tag}</span>
                        </article>
                    ))}
                </div>
            </section>
            <section
                class="perspective wrap"
                aria-labelledby="perspective-title"
            >
                <div class="network-icon" aria-hidden="true">
                    ↙<span>↗</span>
                </div>
                <div>
                    <h2 id="perspective-title">
                        From the big picture
                        <br />
                        to the details.
                    </h2>
                </div>
                <p>
                    Start with your server’s health at a glance. Look through
                    usage charts, check individual disks, and inspect busy
                    processes. See network activity alongside it all, in the
                    same overview.
                </p>
            </section>
            <section class="closing wrap" aria-labelledby="closing-title">
                <div>
                    <h2 id="closing-title">
                        A clearer view
                        <br />
                        starts here.
                    </h2>
                </div>
                <div>
                    <p>
                        Take a look around.
                        <br />
                        Get a feel for your next server dashboard.
                    </p>
                    <cds-button href="#demo">
                        Explore the demo{" "}
                        <span slot="icon" aria-hidden="true">
                            →
                        </span>
                    </cds-button>
                </div>
                <svg
                    class="closing-pulse"
                    viewBox="0 0 600 200"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M0 110h180l45-70 70 150 65-180 45 100h195"
                        stroke="currentColor"
                        stroke-width="1"
                    />
                </svg>
            </section>
        </main>
        <footer class="footer wrap">
            <a class="brand" href="/">
                PulseBoard
            </a>
            <span>A little clarity for your corner of the internet.</span>
            <nav class="legal" aria-label="Legal">
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </nav>
        </footer>
    </div>
</HtmlTemplate>

<style>
    :global(html) {
        scroll-behavior: smooth;
        scroll-padding-top: 30px;
        background: var(--cds-background, #fff);
    }
    :global(body) {
        margin: 0;
        width: 100%;
        height: auto;
        color: var(--cds-text-primary, #161616);
        -webkit-font-smoothing: antialiased;
    }
    .site {
        overflow: clip;
        background: var(--cds-background, #fff);
    }
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }
    a {
        color: inherit;
        text-decoration: none;
    }
    a:focus-visible {
        outline: 2px solid var(--cds-link-primary, #0f62fe);
        outline-offset: 6px;
    }
    a:hover {
        color: var(--cds-link-primary, #0f62fe);
    }
    h1,
    h2,
    h3,
    p {
        margin: 0;
    }
    .wrap {
        width: min(1120px, calc(100% - 80px));
        margin-inline: auto;
    }
    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 100px;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        gap: 24px;
    }
    .brand {
        display: flex;
        gap: 10px;
        align-items: center;
        font-size: 21px;
        font-weight: 600;
        letter-spacing: -0.8px;
    }
    nav {
        display: flex;
        align-items: center;
        gap: 34px;
        font-size: 12px;
    }
    nav a > span {
        margin-left: 8px;
    }
    /* Both sets share one grid cell, so the nav keeps the wider one's size
       while /api/auth/me is pending and when either set is revealed */
    .nav-account {
        display: grid;
        justify-items: end;
        align-items: center;
    }
    .nav-guest,
    .nav-user {
        grid-area: 1 / 1;
        display: flex;
        align-items: center;
        gap: 34px;
    }
    .nav-account[data-auth="pending"] > *,
    .nav-account[data-auth="guest"] > .nav-user,
    .nav-account[data-auth="user"] > .nav-guest {
        visibility: hidden;
    }
    /* Fixed width so filling in the name can't move the nav */
    .nav-user-name {
        width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: right;
        color: var(--cds-text-secondary, #525252);
    }
    cds-button {
        flex-shrink: 0;
    }
    .hero {
        padding-top: 78px;
    }
    .hero-row {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 55px;
        align-items: center;
    }
    h1 {
        font-size: clamp(45px, 5.1vw, 68px);
        line-height: 1.07;
        letter-spacing: -1.5px;
        font-weight: 400;
    }
    h1 em {
        font-style: normal;
        color: var(--cds-link-primary, #0f62fe);
    }
    .hero-copy > p {
        color: var(--cds-text-secondary, #525252);
        font-size: 15px;
        line-height: 1.8;
        max-width: 390px;
    }
    .demo {
        margin-top: 64px;
    }
    .demo-caption {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 15px;
        gap: 15px;
        color: var(--cds-text-secondary, #525252);
        font:
            9px ui-monospace,
            monospace;
        letter-spacing: 1.3px;
    }
    .demo-caption > span > span {
        color: var(--cds-link-primary, #0f62fe);
        margin-left: 8px;
    }
    .features {
        padding-top: 108px;
        padding-bottom: 75px;
    }
    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 40px;
        margin-bottom: 40px;
    }
    h2 {
        font-size: 44px;
        line-height: 1.12;
        font-weight: 400;
        letter-spacing: -0.8px;
    }
    .section-heading > p,
    .perspective > p {
        max-width: 330px;
        color: var(--cds-text-secondary, #525252);
        font-size: 14px;
        line-height: 1.85;
    }
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--cds-border-subtle, #e0e0e0);
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
    article {
        padding: 28px 22px 28px 0;
        display: flex;
        flex-direction: column;
    }
    article + article {
        border-left: 1px solid var(--cds-border-subtle, #e0e0e0);
        padding-left: 22px;
    }
    .number {
        font:
            11px ui-monospace,
            monospace;
        color: var(--cds-link-primary, #0f62fe);
    }
    .number span {
        margin-left: 10px;
        color: var(--cds-text-secondary, #525252);
    }
    article h3 {
        font-size: 17px;
        font-weight: 400;
        letter-spacing: -0.4px;
        margin: 32px 0 14px;
    }
    article p {
        color: var(--cds-text-secondary, #525252);
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 30px;
    }
    .feature-tag {
        margin-top: auto;
        color: var(--cds-text-secondary, #525252);
        font:
            8px ui-monospace,
            monospace;
        letter-spacing: 0.7px;
    }
    .perspective {
        display: grid;
        grid-template-columns: 100px 1fr 1fr;
        align-items: center;
        gap: 40px;
        padding-bottom: 90px;
    }
    .network-icon {
        width: 86px;
        height: 86px;
        border: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 35px;
        color: var(--cds-link-primary, #0f62fe);
        display: flex;
        align-items: center;
        justify-content: center;
        letter-spacing: -7px;
        padding-right: 7px;
        background: var(--cds-layer-01, #f4f4f4);
    }
    .network-icon span {
        transform: translateY(-8px);
    }
    .perspective h2 {
        font-size: 32px;
    }
    .closing {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
        isolation: isolate;
        padding: 48px 55px;
        border: 1px solid var(--cds-border-subtle, #e0e0e0);
        background: var(--cds-layer-01, #f4f4f4);
        overflow: hidden;
    }
    .closing h2 {
        color: var(--cds-link-primary, #0f62fe);
        font-size: 49px;
    }
    .closing > div + div {
        margin-right: 30px;
    }
    .closing p {
        color: var(--cds-text-secondary, #525252);
        font-size: 13px;
        line-height: 1.8;
        margin-bottom: 23px;
    }
    .closing-pulse {
        position: absolute;
        z-index: -1;
        width: 68%;
        right: -8%;
        top: 0;
        height: 100%;
        color: var(--cds-border-interactive, #0f62fe);
        opacity: 0.2;
    }
    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-block: 40px;
    }
    .footer .brand {
        font-size: 16px;
    }
    .footer > span {
        color: var(--cds-text-secondary, #525252);
        font-size: 11px;
    }
    .footer > a:last-child {
        font-size: 11px;
    }
    .footer .legal {
        display: flex;
        gap: 16px;
        font-size: 11px;
    }
    .skip-link {
        position: fixed;
        top: -100px;
        left: 20px;
        background: var(--cds-link-primary, #0f62fe);
        color: var(--cds-text-on-color, #fff);
        padding: 12px 20px;
        z-index: 100;
    }
    .skip-link:focus {
        top: 12px;
    }
    @media (max-width: 1000px) {
        .hero-row {
            grid-template-columns: 1fr;
            gap: 25px;
        }
        .hero-copy > p {
            max-width: 580px;
        }
        h1 {
            font-size: 64px;
        }
        .feature-grid {
            grid-template-columns: 1fr 1fr;
        }
        article:nth-child(3) {
            border-left: none;
            padding-left: 0;
        }
        article:nth-child(n + 3) {
            border-top: 1px solid var(--cds-border-subtle, #e0e0e0);
        }
        .perspective {
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }
        .network-icon {
            display: none;
        }
    }
    @media (max-width: 600px) {
        .wrap {
            width: calc(100% - 36px);
        }
        .header {
            min-height: 80px;
            gap: 15px;
            flex-wrap: wrap;
            padding-block: 16px;
        }
        .brand {
            font-size: 19px;
        }
        nav,
        .nav-guest,
        .nav-user {
            gap: 12px;
        }
        .nav-user-name {
            width: 90px;
        }
        nav .nav-feature {
            display: none;
        }
        .hero {
            padding-top: 50px;
        }
        h1 {
            font-size: clamp(36px, 9.5vw, 56px);
            letter-spacing: -2px;
        }
        .hero-copy > p {
            font-size: 14px;
        }

        .demo {
            margin-top: 40px;
        }
        .demo-caption {
            font-size: 10px;
            letter-spacing: 0.6px;
        }
        .features {
            padding-top: 65px;
            padding-bottom: 45px;
        }
        .section-heading {
            align-items: start;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 28px;
        }
        h2 {
            font-size: 36px;
        }
        article {
            padding-right: 15px;
        }
        article + article {
            padding-left: 15px;
        }
        article h3 {
            font-size: 17px;
            line-height: 1.3;
        }
        .feature-tag {
            font-size: 10px;
            letter-spacing: 0;
        }
        .perspective {
            grid-template-columns: 1fr;
            padding-bottom: 45px;
        }
        .closing {
            padding: 32px 24px;
            flex-direction: column;
            align-items: start;
            gap: 28px;
        }
        .closing h2 {
            font-size: 43px;
        }
        .closing > div + div {
            margin: 0;
        }
        .footer {
            flex-wrap: wrap;
            padding-block: 30px;
        }
        .footer > span {
            order: 3;
            width: 100%;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        :global(html) {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    import "@carbon/web-components/es/components/button/index.js";
</script>

<script>
    import { accountDestination, currentUser, logout } from "../lib/auth";

    const account = document.querySelector<HTMLElement>(".nav-account")!;

    // A hung request counts as a failure: show the logged-out buttons
    const timeout = new Promise<null>((resolve) =>
        setTimeout(() => resolve(null), 5000),
    );

    Promise.race([currentUser(), timeout]).then((user) => {
        if (user) {
            const name = document.getElementById("nav-user-name")!;
            name.textContent = name.title = user.username || user.email;
            document
                .getElementById("nav-dashboard")!
                .setAttribute("href", accountDestination(user));
        }
        account.dataset["auth"] = user ? "user" : "guest";
    });

    document.getElementById("nav-logout")!.addEventListener("click", (e) => {
        e.preventDefault();
        logout();
    });
</script>
