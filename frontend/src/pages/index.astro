---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
import DashboardPreview from "../components/DashboardPreview.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { limits } from "../lib/limits";
import { planById, plans, price, trialDays } from "../lib/pricing";

const features = [
    {
        number: "01",
        title: "See resource pressure.",
        text: "CPU usage, memory consumption, and system load. Get the context you need to understand a busy server.",
        tag: "CPU / MEMORY / LOAD",
    },
    {
        number: "02",
        title: "Put spikes in context.",
        text: "Follow CPU and memory trends over time. See whether that jump is a passing moment or a pattern worth investigating.",
        tag: "USAGE HISTORY",
    },
    {
        number: "03",
        title: "Keep storage in sight.",
        text: "Check usage across mount points and see where space is getting tight, without losing the bigger picture.",
        tag: "DISKS / MOUNT POINTS",
    },
    {
        number: "04",
        title: "Check what’s running.",
        text: "Review service status and the processes consuming the most resources. Know where to look next.",
        tag: "SERVICES / PROCESSES",
    },
];

const columns = [
    {
        name: "timestamp",
        text: "When the reading was taken, e.g. 2026-09-01T12:00:00Z. Without a time zone it is read as UTC.",
    },
    { name: "host", text: "The server’s name." },
    {
        name: "cpu_percent, ram_percent, disk_percent",
        text: "Usage from 0 to 100.",
    },
    {
        name: "net_in_mbps, net_out_mbps",
        text: "Incoming and outgoing traffic in megabits per second.",
    },
];

const alternatives = [
    {
        name: "Netdata",
        text: "Installs an agent on every server and streams per-second metrics, with alerts built in.",
        pick: "Pick it for real-time monitoring.",
    },
    {
        name: "Beszel",
        text: "A lightweight hub plus an agent on each system, tracking resources and Docker containers, with alerts.",
        pick: "Pick it for simple self-hosted monitoring.",
    },
    {
        name: "Grafana",
        text: "Dashboards on top of data sources such as Prometheus or a database, which you run and fill yourself.",
        pick: "Pick it if you already have a metrics pipeline.",
    },
    {
        name: "Uptime Kuma",
        text: "Checks whether websites and services respond over HTTP, TCP or ping, with status pages and notifications.",
        pick: "Pick it for uptime, not resource usage.",
    },
];

const collected = [
    {
        title: "Your account",
        text: "Your email address, a username if you set one, and a hash of your password. With Google or Facebook sign-in, your ID and name there, and no password.",
    },
    {
        title: "Your CSV files",
        text: "The server metrics you upload, kept until you delete them. They are only visible from your account.",
    },
    {
        title: "Payments",
        text: "Stripe handles checkout. We keep your Stripe customer and subscription IDs and your plan, never your card number.",
    },
    {
        title: "Cookies",
        text: "Two strictly necessary ones: your session, and a short-lived one during Google or Facebook sign-in. No analytics, advertising or tracking.",
    },
];

const monthly = planById("subscription");
const yearly = planById("yearly");
const lifetime = planById("lifetime");
const faq = [
    {
        question: "Do I need to install anything on my servers?",
        answer: "No. PulseBoard doesn’t connect to or monitor your servers. It shows the readings in the CSV files you upload, so there is no live data and there are no alerts.",
    },
    {
        question: "How accurate are the forecasts?",
        answer: `They are estimates, not a guarantee. A host needs at least ${limits.forecastDays} days of readings, and you are responsible for the decisions you make based on them.`,
    },
    {
        question: "What’s the difference between the plans?",
        answer: `All plans include all features, and every new account starts with a ${trialDays}-day free trial, no card needed. The subscription costs ${price(monthly)} a month or ${price(yearly)} a year and renews until you cancel it in the Stripe Customer Portal, where you can also switch between monthly and yearly; you keep access until the end of the paid period. The lifetime license is a one-time ${price(lifetime)} for as long as we run PulseBoard, and buying it cancels an active subscription.`,
    },
    {
        question: "Can I get a refund?",
        answer: "Before checkout you agree that access starts immediately, so you lose the 14-day right of withdrawal once it does. We don’t refund partial subscription months, except where the law requires it.",
    },
    {
        question: "How do I delete my data?",
        answer: "Delete a single dataset on the Datasets page, or your whole account in account settings. Deleting the account also cancels any subscription. Deleted data is gone from our backups within about 5 weeks.",
    },
];
---

<HtmlTemplate
    title="PulseBoard — Your server’s pulse, at a glance"
    description="A clear view of Linux server health. Explore CPU, memory, storage, network, and services in the PulseBoard sample dashboard."
>
    <a class="skip-link" href="#main">
        Skip to content
    </a>
    <div class="site">
        <header class="header wrap">
            <a class="brand" href="/" aria-label="PulseBoard home">
                PulseBoard
            </a>
            <nav aria-label="Main navigation">
                <a class="nav-feature" href="#features">
                    Features
                </a>
                <a class="nav-feature" href="#pricing">
                    Pricing
                </a>
                <div class="nav-account" data-auth="pending">
                    <div class="nav-guest">
                        <a href="/login">
                            Log in <span aria-hidden="true">↗</span>
                        </a>
                        <cds-button
                            class="nav-register"
                            kind="tertiary"
                            size="md"
                            href="/register"
                        >
                            Create account{" "}
                            <span slot="icon" aria-hidden="true">
                                →
                            </span>
                        </cds-button>
                    </div>
                    <div class="nav-user">
                        <span class="nav-user-name" id="nav-user-name"></span>
                        <a href="/" id="nav-logout">
                            Log out
                        </a>
                        <cds-button
                            id="nav-dashboard"
                            kind="tertiary"
                            size="md"
                            href="/overview"
                        >
                            Go to dashboard{" "}
                            <span slot="icon" aria-hidden="true">
                                →
                            </span>
                        </cds-button>
                    </div>
                </div>
            </nav>
        </header>
        <main id="main">
            <section class="hero wrap" aria-labelledby="hero-title">
                <div class="hero-row">
                    <h1 id="hero-title">
                        Your server’s pulse,
                        <br />
                        <em>at a glance.</em>
                    </h1>
                    <div class="hero-copy">
                        <p>
                            CPU, memory, storage, network, and services—in one
                            clear dashboard. See what’s busy, what’s filling up,
                            and what needs a closer look.
                        </p>
                        <div class="hero-actions">
                            <cds-button href="/register" data-get-started>
                                Get started{" "}
                                <span slot="icon" aria-hidden="true">
                                    →
                                </span>
                            </cds-button>
                            <a
                                class="text-link"
                                href="/#pricing"
                                data-pricing-link
                            >
                                See pricing <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </div>
                </div>
                <section id="demo" class="demo" aria-label="Dashboard preview">
                    <div class="demo-caption">
                        <span>
                            INTERACTIVE PREVIEW{" "}
                            <span aria-hidden="true">↓</span>
                        </span>
                    </div>
                    <DashboardPreview />
                </section>
            </section>
            <section
                class="features wrap"
                id="features"
                aria-labelledby="features-title"
            >
                <div class="section-heading">
                    <div>
                        <h2 id="features-title">
                            Know where
                            <br />
                            to look next.
                        </h2>
                    </div>
                    <p>
                        A focused overview for developers and people running
                        their own servers. The essentials, with room to look
                        closer.
                    </p>
                </div>
                <div class="feature-grid">
                    {features.map((feature) => (
                        <article>
                            <span class="number">
                                {feature.number}{" "}
                                <span aria-hidden="true">/</span>
                            </span>
                            <h3>{feature.title}</h3>
                            <p>{feature.text}</p>
                            <span class="feature-tag">{feature.tag}</span>
                        </article>
                    ))}
                </div>
            </section>
            <section
                class="perspective wrap"
                aria-labelledby="perspective-title"
            >
                <div class="network-icon" aria-hidden="true">
                    ↙<span>↗</span>
                </div>
                <div>
                    <h2 id="perspective-title">
                        From the big picture
                        <br />
                        to the details.
                    </h2>
                </div>
                <p>
                    Start with your server’s health at a glance. Look through
                    usage charts, check individual disks, and inspect busy
                    processes. See network activity alongside it all, in the
                    same overview.
                </p>
            </section>
            <section class="data wrap" id="data" aria-labelledby="data-title">
                <div class="section-heading">
                    <h2 id="data-title">
                        How data
                        <br />
                        gets in.
                    </h2>
                    <p>
                        Export your readings to a CSV file and import it on the
                        Datasets page. Nothing runs on your servers.
                    </p>
                </div>
                <div class="data-grid">
                    <div>
                        <h3>Columns</h3>
                        <p class="muted">
                            The first line names these columns, in any order.
                            Commas or semicolons and decimal commas work, so
                            files saved from Excel import as they are.
                        </p>
                        <dl class="columns">
                            {columns.map((column) => (
                                <div>
                                    <dt>{column.name}</dt>
                                    <dd>{column.text}</dd>
                                </div>
                            ))}
                        </dl>
                    </div>
                    <div>
                        <h3>Limits</h3>
                        <ul class="limits">
                            <li>
                                <strong>{limits.datasets}</strong> datasets per
                                account
                            </li>
                            <li>
                                <strong>{limits.fileSize}</strong> per file
                            </li>
                            <li>
                                <strong>{limits.rows}</strong> rows per file
                            </li>
                        </ul>
                        <p class="muted">
                            Rows with mistakes are skipped and listed. If more
                            than {limits.invalidShare} of rows have mistakes,
                            nothing is imported.
                        </p>
                        <a class="text-link" href="/samples">
                            Download sample files{" "}
                            <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </div>
            </section>
            <section class="why wrap" id="why" aria-labelledby="why-title">
                <div class="section-heading">
                    <h2 id="why-title">
                        Why
                        <br />
                        PulseBoard.
                    </h2>
                    <p>
                        There’s no agent to install: you upload CSV exports.
                        PulseBoard adds history, statistics and forecasts,
                        including when disk and RAM will reach{" "}
                        {limits.thresholds}. If you need live monitoring or
                        alerts, one of these fits better.
                    </p>
                </div>
                <div class="feature-grid">
                    {alternatives.map((tool) => (
                        <article>
                            <h3>{tool.name}</h3>
                            <p>{tool.text}</p>
                            <span class="feature-tag">{tool.pick}</span>
                        </article>
                    ))}
                </div>
            </section>
            <section
                class="pricing wrap"
                id="pricing"
                aria-labelledby="pricing-title"
            >
                <div class="section-heading">
                    <h2 id="pricing-title">Pricing.</h2>
                    <p>
                        Every new account gets a {trialDays}-day free trial with
                        full access, no card needed. After that, the dashboards
                        need a paid license. Payments are processed by Stripe.
                    </p>
                </div>
                <div class="plans">
                    {plans.map((plan) => (
                        <article>
                            <h3>{plan.name}</h3>
                            <p class="price">
                                {price(plan)}{" "}
                                <span class="period">{plan.period}</span>
                            </p>
                            <p>{plan.note}</p>
                            <ul>
                                {plan.features.map((feature) => (
                                    <li>{feature}</li>
                                ))}
                            </ul>
                        </article>
                    ))}
                </div>
                <cds-button href="/register" data-get-started>
                    Get started{" "}
                    <span slot="icon" aria-hidden="true">
                        →
                    </span>
                </cds-button>
            </section>
            <section class="collected wrap" aria-labelledby="collected-title">
                <div class="section-heading">
                    <h2 id="collected-title">
                        What data
                        <br />
                        we collect.
                    </h2>
                    <a class="text-link" href="/privacy">
                        Read the Privacy Policy{" "}
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
                <div class="feature-grid">
                    {collected.map((item) => (
                        <article>
                            <h3>{item.title}</h3>
                            <p>{item.text}</p>
                        </article>
                    ))}
                </div>
            </section>
            <section class="faq wrap" aria-labelledby="faq-title">
                <div class="section-heading">
                    <h2 id="faq-title">Questions.</h2>
                    <a class="text-link" href="/terms">
                        Read the Terms of Service{" "}
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
                <div class="faq-list">
                    {faq.map((item) => (
                        <details>
                            <summary>{item.question}</summary>
                            <p>{item.answer}</p>
                        </details>
                    ))}
                </div>
            </section>
            <section class="closing wrap" aria-labelledby="closing-title">
                <div>
                    <h2 id="closing-title">
                        A clearer view
                        <br />
                        starts here.
                    </h2>
                </div>
                <div>
                    <p>
                        Take a look around.
                        <br />
                        Get a feel for your next server dashboard.
                    </p>
                    <cds-button href="#demo">
                        Explore the demo{" "}
                        <span slot="icon" aria-hidden="true">
                            →
                        </span>
                    </cds-button>
                </div>
                <svg
                    class="closing-pulse"
                    viewBox="0 0 600 200"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M0 110h180l45-70 70 150 65-180 45 100h195"
                        stroke="currentColor"
                        stroke-width="1"
                    />
                </svg>
            </section>
        </main>
        <div class="wrap">
            <SiteFooter />
        </div>
    </div>
</HtmlTemplate>

<style>
    :global(html) {
        scroll-behavior: smooth;
        scroll-padding-top: 30px;
        background: var(--cds-background, #fff);
    }
    :global(body) {
        margin: 0;
        width: 100%;
        height: auto;
        color: var(--cds-text-primary, #161616);
        -webkit-font-smoothing: antialiased;
    }
    .site {
        overflow: clip;
        background: var(--cds-background, #fff);
    }
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }
    a {
        color: inherit;
        text-decoration: none;
    }
    a:focus-visible {
        outline: 2px solid var(--cds-link-primary, #0f62fe);
        outline-offset: 6px;
    }
    a:hover {
        color: var(--cds-link-primary, #0f62fe);
    }
    h1,
    h2,
    h3,
    p {
        margin: 0;
    }
    .wrap {
        width: min(1120px, calc(100% - 80px));
        margin-inline: auto;
    }
    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 100px;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        gap: 24px;
    }
    .brand {
        display: flex;
        gap: 10px;
        align-items: center;
        font-size: 21px;
        font-weight: 600;
        letter-spacing: -0.8px;
    }
    nav {
        display: flex;
        align-items: center;
        gap: 34px;
        font-size: 12px;
    }
    nav a > span {
        margin-left: 8px;
    }
    /* Both sets share one grid cell, so the nav keeps the wider one's size
       while /api/auth/me is pending and when either set is revealed */
    .nav-account {
        display: grid;
        justify-items: end;
        align-items: center;
    }
    .nav-guest,
    .nav-user {
        grid-area: 1 / 1;
        display: flex;
        align-items: center;
        gap: 34px;
    }
    .nav-account[data-auth="pending"] > *,
    .nav-account[data-auth="guest"] > .nav-user,
    .nav-account[data-auth="user"] > .nav-guest {
        visibility: hidden;
    }
    /* Fixed width so filling in the name can't move the nav */
    .nav-user-name {
        width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: right;
        color: var(--cds-text-secondary, #525252);
    }
    cds-button {
        flex-shrink: 0;
    }
    .hero {
        padding-top: 78px;
    }
    .hero-row {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 55px;
        align-items: center;
    }
    h1 {
        font-size: clamp(45px, 5.1vw, 68px);
        line-height: 1.07;
        letter-spacing: -1.5px;
        font-weight: 400;
    }
    h1 em {
        font-style: normal;
        color: var(--cds-link-primary, #0f62fe);
    }
    .hero-copy > p {
        color: var(--cds-text-secondary, #525252);
        font-size: 15px;
        line-height: 1.8;
        max-width: 390px;
    }
    .demo {
        margin-top: 64px;
    }
    .demo-caption {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 15px;
        gap: 15px;
        color: var(--cds-text-secondary, #525252);
        font:
            9px ui-monospace,
            monospace;
        letter-spacing: 1.3px;
    }
    .demo-caption > span > span {
        color: var(--cds-link-primary, #0f62fe);
        margin-left: 8px;
    }
    .features {
        padding-top: 108px;
        padding-bottom: 75px;
    }
    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 40px;
        margin-bottom: 40px;
    }
    h2 {
        font-size: 44px;
        line-height: 1.12;
        font-weight: 400;
        letter-spacing: -0.8px;
    }
    .section-heading > p,
    .perspective > p {
        max-width: 330px;
        color: var(--cds-text-secondary, #525252);
        font-size: 14px;
        line-height: 1.85;
    }
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--cds-border-subtle, #e0e0e0);
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
    article {
        padding: 28px 22px 28px 0;
        display: flex;
        flex-direction: column;
    }
    article + article {
        border-left: 1px solid var(--cds-border-subtle, #e0e0e0);
        padding-left: 22px;
    }
    .number {
        font:
            11px ui-monospace,
            monospace;
        color: var(--cds-link-primary, #0f62fe);
    }
    .number span {
        margin-left: 10px;
        color: var(--cds-text-secondary, #525252);
    }
    article h3 {
        font-size: 17px;
        font-weight: 400;
        letter-spacing: -0.4px;
        margin: 32px 0 14px;
    }
    article p {
        color: var(--cds-text-secondary, #525252);
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 30px;
    }
    .feature-tag {
        margin-top: auto;
        color: var(--cds-text-secondary, #525252);
        font:
            8px ui-monospace,
            monospace;
        letter-spacing: 0.7px;
    }
    .perspective {
        display: grid;
        grid-template-columns: 100px 1fr 1fr;
        align-items: center;
        gap: 40px;
        padding-bottom: 90px;
    }
    .network-icon {
        width: 86px;
        height: 86px;
        border: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 35px;
        color: var(--cds-link-primary, #0f62fe);
        display: flex;
        align-items: center;
        justify-content: center;
        letter-spacing: -7px;
        padding-right: 7px;
        background: var(--cds-layer-01, #f4f4f4);
    }
    .network-icon span {
        transform: translateY(-8px);
    }
    .perspective h2 {
        font-size: 32px;
    }
    .closing {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
        isolation: isolate;
        padding: 48px 55px;
        border: 1px solid var(--cds-border-subtle, #e0e0e0);
        background: var(--cds-layer-01, #f4f4f4);
        overflow: hidden;
    }
    .closing h2 {
        color: var(--cds-link-primary, #0f62fe);
        font-size: 49px;
    }
    .closing > div + div {
        margin-right: 30px;
    }
    .closing p {
        color: var(--cds-text-secondary, #525252);
        font-size: 13px;
        line-height: 1.8;
        margin-bottom: 23px;
    }
    .closing-pulse {
        position: absolute;
        z-index: -1;
        width: 68%;
        right: -8%;
        top: 0;
        height: 100%;
        color: var(--cds-border-interactive, #0f62fe);
        opacity: 0.2;
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 32px;
        margin-top: 32px;
    }
    .text-link {
        color: var(--cds-link-primary, #0f62fe);
        font-size: 14px;
    }
    .text-link:hover {
        color: var(--cds-link-primary-hover, #0043ce);
        text-decoration: underline;
    }
    .text-link > span {
        margin-left: 8px;
    }
    .data,
    .why,
    .pricing,
    .collected,
    .faq {
        padding-bottom: 90px;
    }
    .data-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        border-top: 1px solid var(--cds-border-subtle, #e0e0e0);
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
    .data-grid > div {
        padding: 28px 22px 28px 0;
    }
    .data-grid > div + div {
        border-left: 1px solid var(--cds-border-subtle, #e0e0e0);
        padding-left: 22px;
    }
    .data-grid h3,
    .why article h3,
    .collected article h3,
    .plans h3 {
        font-size: 17px;
        font-weight: 400;
        letter-spacing: -0.4px;
        margin: 0 0 14px;
    }
    .muted {
        color: var(--cds-text-secondary, #525252);
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 20px;
    }
    .columns {
        margin: 0;
    }
    .columns > div {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
        gap: 16px;
        padding: 12px 0;
        border-top: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
    .columns dt {
        font:
            12px/1.6 ui-monospace,
            monospace;
        overflow-wrap: anywhere;
    }
    .columns dd {
        margin: 0;
        color: var(--cds-text-secondary, #525252);
        font-size: 14px;
        line-height: 1.6;
    }
    .limits {
        margin: 0 0 20px;
        padding: 0;
        list-style: none;
    }
    .limits li {
        padding: 12px 0;
