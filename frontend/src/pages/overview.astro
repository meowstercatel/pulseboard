---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
import UsageChart from "../components/UsageChart.astro";

// Placeholder data until the backend exposes a stats endpoint.
const server = {
    hostname: "web-01",
    ip: "10.0.0.12",
    os: "Ubuntu 24.04.1 LTS",
    kernel: "6.8.0-45-generic",
    uptime: "23d 4h 17m",
    online: true,
};

const cpu = { usage: 42, cores: 8, model: "AMD EPYC 7763", temp: 58 };
const memory = { used: 11.4, total: 16 };
const swap = { used: 0.3, total: 2 };
const load = [1.82, 1.64, 1.41];

const cpuHistory = [
    31, 35, 28, 40, 44, 39, 52, 61, 58, 47, 43, 38, 41, 49, 55, 50, 46, 42, 37,
    40, 45, 48, 44, 42,
];
const memHistory = [
    64, 65, 65, 66, 68, 67, 69, 71, 72, 70, 70, 69, 70, 71, 72, 73, 72, 71, 71,
    70, 71, 72, 71, 71,
];

const disks = [
    { mount: "/", device: "/dev/nvme0n1p2", fs: "ext4", used: 38.2, total: 98 },
    {
        mount: "/var",
        device: "/dev/nvme0n1p3",
        fs: "ext4",
        used: 171.5,
        total: 196,
    },
    {
        mount: "/boot",
        device: "/dev/nvme0n1p1",
        fs: "vfat",
        used: 0.12,
        total: 0.5,
    },
];

const network = {
    iface: "eth0",
    rx: "12.4 MB/s",
    tx: "3.1 MB/s",
    rxTotal: "1.82 TB",
    txTotal: "412 GB",
};

const processes = [
    { pid: 1423, user: "postgres", name: "postgres", cpu: 18.2, mem: 12.4 },
    { pid: 2210, user: "www-data", name: "node", cpu: 9.7, mem: 6.1 },
    { pid: 987, user: "root", name: "nginx", cpu: 3.4, mem: 0.8 },
    { pid: 3311, user: "redis", name: "redis-server", cpu: 2.1, mem: 2.3 },
    { pid: 1, user: "root", name: "systemd", cpu: 0.3, mem: 0.1 },
    { pid: 655, user: "root", name: "sshd", cpu: 0.1, mem: 0.1 },
];

const services = [
    { name: "nginx.service", active: true },
    { name: "postgresql.service", active: true },
    { name: "redis-server.service", active: true },
    { name: "app-worker.service", active: false },
];

const percent = (used: number, total: number) =>
    Math.round((used / total) * 100);
const status = (p: number) => (p >= 90 ? "error" : "active");
---

<HtmlTemplate>
    <main>
        <cds-header aria-label="PulseBoard">
            <cds-header-name href="/overview">PulseBoard</cds-header-name>
            <cds-header-nav menu-bar-label="PulseBoard">
                <cds-header-nav-item href="/overview">
                    Overview
                </cds-header-nav-item>
                <cds-header-nav-item href="javascript:void 0">
                    Alerts
                </cds-header-nav-item>
                <cds-header-menu menu-label="Account" trigger-content="Account">
                    <cds-header-menu-item href="/buy">
                        License
                    </cds-header-menu-item>
                    <cds-header-menu-item href="/">
                        Log out
                    </cds-header-menu-item>
                </cds-header-menu>
            </cds-header-nav>
        </cds-header>

        <div class="cds-ce-demo-devenv--container">
            <section class="content">
                <div class="page-header">
                    <div>
                        <h1>
                            {server.hostname}
                            <cds-tag
                                type={server.online ? "green" : "red"}
                                size="md"
                            >
                                {server.online ? "Online" : "Offline"}
                            </cds-tag>
                        </h1>
                        <p class="meta">
                            {server.ip} · {server.os} · kernel {server.kernel} ·
                            up {server.uptime}
                        </p>
                    </div>
                    <p class="meta">
                        Last updated: <span id="last-updated">just now</span>
                    </p>
                </div>

                <div class="grid kpis">
                    <cds-tile>
                        <p class="label">CPU</p>
                        <p class="value">
                            {cpu.usage}
                            <span class="unit">%</span>
                        </p>
                        <cds-progress-bar
                            label="CPU usage"
                            hide-label=""
                            value={cpu.usage}
                            status={status(cpu.usage)}
                        ></cds-progress-bar>
                        <p class="meta">
                            {cpu.cores} cores · {cpu.model} · {cpu.temp}°C
                        </p>
                    </cds-tile>
                    <cds-tile>
                        <p class="label">Memory</p>
                        <p class="value">
                            {percent(memory.used, memory.total)}
                            <span class="unit">%</span>
                        </p>
                        <cds-progress-bar
                            label="Memory usage"
                            hide-label=""
                            value={percent(memory.used, memory.total)}
                            status={status(percent(memory.used, memory.total))}
                        ></cds-progress-bar>
                        <p class="meta">
                            {memory.used} / {memory.total} GiB · swap{" "}
                            {swap.used} / {swap.total} GiB
                        </p>
                    </cds-tile>
                    <cds-tile>
                        <p class="label">Load average</p>
                        <p class="value">{load[0].toFixed(2)}</p>
                        <p class="meta">
                            1m {load[0].toFixed(2)} · 5m {load[1].toFixed(2)} ·
                            15m {load[2].toFixed(2)}
                        </p>
                    </cds-tile>
                    <cds-tile>
                        <p class="label">Network ({network.iface})</p>
                        <p class="value net">
                            <span>↓ {network.rx}</span>
                            <span>↑ {network.tx}</span>
                        </p>
                        <p class="meta">
                            Total received {network.rxTotal} · sent{" "}
                            {network.txTotal}
                        </p>
                    </cds-tile>
                </div>

                <div class="grid charts">
                    <cds-tile>
                        <UsageChart
                            title="CPU usage · last 2 hours"
                            series={cpuHistory}
                        />
                    </cds-tile>
                    <cds-tile>
                        <UsageChart
                            title="Memory usage · last 2 hours"
                            series={memHistory}
                        />
                    </cds-tile>
                </div>

                <div class="grid split">
                    <cds-tile>
                        <p class="label">Storage</p>
                        <div class="disks">
                            {disks.map((d) => (
                                <div class="disk">
                                    <cds-progress-bar
                                        label={`${d.mount}  (${d.device}, ${d.fs})`}
                                        helper-text={`${d.used} / ${d.total} GiB · ${percent(d.used, d.total)}%`}
                                        value={percent(d.used, d.total)}
                                        status={status(
                                            percent(d.used, d.total),
                                        )}
                                    />
                                </div>
                            ))}
                        </div>
                    </cds-tile>
                    <cds-tile>
                        <p class="label">Services</p>
                        <ul class="services">
                            {services.map((s) => (
                                <li>
                                    <span>{s.name}</span>
                                    <cds-tag
                                        type={s.active ? "green" : "red"}
                                        size="sm"
                                    >
                                        {s.active ? "active" : "failed"}
                                    </cds-tag>
                                </li>
                            ))}
                        </ul>
                    </cds-tile>
                </div>

                <cds-table>
                    <cds-table-header-title slot="title">
                        Top processes
                    </cds-table-header-title>
                    <cds-table-header-description slot="description">
                        Sorted by CPU usage
                    </cds-table-header-description>
                    <cds-table-head>
                        <cds-table-header-row>
                            <cds-table-header-cell>PID</cds-table-header-cell>
                            <cds-table-header-cell>User</cds-table-header-cell>
                            <cds-table-header-cell>
                                Command
                            </cds-table-header-cell>
                            <cds-table-header-cell>CPU %</cds-table-header-cell>
                            <cds-table-header-cell>MEM %</cds-table-header-cell>
                        </cds-table-header-row>
                    </cds-table-head>
                    <cds-table-body>
                        {processes.map((p) => (
                            <cds-table-row>
                                <cds-table-cell>{p.pid}</cds-table-cell>
                                <cds-table-cell>{p.user}</cds-table-cell>
                                <cds-table-cell>{p.name}</cds-table-cell>
                                <cds-table-cell>
                                    {p.cpu.toFixed(1)}
                                </cds-table-cell>
                                <cds-table-cell>
                                    {p.mem.toFixed(1)}
                                </cds-table-cell>
                            </cds-table-row>
                        ))}
                    </cds-table-body>
                </cds-table>
            </section>
        </div>
    </main>
</HtmlTemplate>

<style>
    main {
        width: 100%;
        height: 100%;
    }
    .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 4rem 2rem 2rem;
        box-sizing: border-box;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;
    }
    h1 {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0;
    }
    .grid {
        display: grid;
        gap: 1rem;
    }
    .kpis {
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
    .charts,
    .split {
        grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    }
    cds-tile {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .label {
        font-weight: 600;
    }
    .value {
        font-size: 2.25rem;
        line-height: 1.2;
    }
    .value.net {
        display: flex;
        flex-direction: column;
        font-size: 1.25rem;
    }
    .unit {
        font-size: 1rem;
        margin-inline-start: 0.125rem;
    }
    .meta {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.875rem;
    }
    .disks {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .services {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .services li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-block-end: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
</style>

<script>
    import "@carbon/web-components/es/components/ui-shell/index.js";
    import "@carbon/web-components/es/components/tile/index.js";
    import "@carbon/web-components/es/components/tag/index.js";
    import "@carbon/web-components/es/components/progress-bar/index.js";
    import "@carbon/web-components/es/components/data-table/index.js";

    const lastUpdated = document.getElementById("last-updated");
    const loadedAt = Date.now();
    setInterval(() => {
        if (lastUpdated) {
            lastUpdated.textContent = `${Math.round((Date.now() - loadedAt) / 1000)}s ago`;
        }
    }, 1000);
</script>
