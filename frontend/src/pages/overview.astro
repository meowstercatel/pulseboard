---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
import DashboardControls from "../components/DashboardControls.astro";
import { metricFields } from "../lib/dashboard";
---

<HtmlTemplate title="Overview · PulseBoard">
    <main>
        <cds-header aria-label="PulseBoard">
            <cds-header-name href="/overview">PulseBoard</cds-header-name>
            <cds-header-nav menu-bar-label="PulseBoard">
                <cds-header-nav-item href="/overview" data-dataset-link>
                    Overview
                </cds-header-nav-item>
                <cds-header-nav-item href="/history" data-dataset-link>
                    History
                </cds-header-nav-item>
                <cds-header-nav-item href="/forecast" data-dataset-link>
                    Forecast
                </cds-header-nav-item>
                <cds-header-nav-item href="/datasets">
                    Datasets
                </cds-header-nav-item>
                <cds-header-menu menu-label="Account" trigger-content="Account">
                    <cds-header-menu-item href="/settings">
                        Settings
                    </cds-header-menu-item>
                    <cds-header-menu-item href="/buy">
                        License
                    </cds-header-menu-item>
                    <cds-header-menu-item href="javascript:void 0" id="logout">
                        Log out
                    </cds-header-menu-item>
                </cds-header-menu>
            </cds-header-nav>
        </cds-header>
        <section class="content">
            <div class="page-header">
                <div>
                    <h1>Overview</h1>
                    <p class="meta">
                        Explore imported server metrics. All times are UTC.
                    </p>
                </div>
                <cds-link href="/datasets">
                    Manage datasets / import CSV
                </cds-link>
            </div>
            <noscript>Enable JavaScript to view imported metrics.</noscript>
            <DashboardControls />
            <p id="status" role="status" aria-live="polite">
                Loading datasets…
            </p>
            <p id="dashboard-error" role="alert" hidden></p>
            <cds-button id="retry" kind="secondary" size="sm" hidden>
                Retry
            </cds-button>
            <div id="results" hidden>
                <div class="page-header">
                    <h2 id="selection-title"></h2>
                    <p class="meta" id="reading-time"></p>
                </div>
                <div class="grid kpis">
                    {metricFields.map(([field, label]) => (
                        <cds-tile>
                            <p class="label">{label}</p>
                            <p class="value" id={`value-${field}`}></p>
                            <p class="meta">Latest imported value</p>
                        </cds-tile>
                    ))}
                </div>
                <p id="sampling" class="meta"></p>
                <div class="grid charts">
                    {metricFields.map(([field, label]) => (
                        <cds-tile>
                            <div class="chart" id={`chart-${field}`}>
                                <div class="page-header">
                                    <h3>{label}</h3>
                                    <span class="scale meta"></span>
                                </div>
                                <div class="plot" tabindex="0" role="img">
                                    <svg
                                        viewBox="0 0 600 160"
                                        preserveAspectRatio="none"
                                        aria-hidden="true"
                                    ></svg>
                                    <span
                                        class="hover-line"
                                        hidden
                                        aria-hidden="true"
                                    ></span>
                                    <span
                                        class="hover-dot"
                                        hidden
                                        aria-hidden="true"
                                    ></span>
                                    <div class="chart-tooltip" hidden>
                                        <p
                                            class="inspection"
                                            role="status"
                                            aria-live="polite"
                                        ></p>
                                    </div>
                                </div>
                                <div class="axis meta">
                                    <span class="axis-start"></span>
                                    <span class="axis-end"></span>
                                </div>
                            </div>
                        </cds-tile>
                    ))}
                </div>
                <details>
                    <summary>View plotted readings as a table</summary>
                    <div class="table-wrap">
                        <table>
                            <caption>
                                Plotted readings (same sampling as charts)
                            </caption>
                            <thead>
                                <tr>
                                    <th>Timestamp (UTC)</th>
                                    {metricFields.map(([, label, unit]) => (
                                        <th>
                                            {label} ({unit})
                                        </th>
                                    ))}
                                </tr>
                            </thead>
                            <tbody id="reading-rows"></tbody>
                        </table>
                    </div>
                </details>
            </div>
        </section>
    </main>
</HtmlTemplate>
<style>
    main {
        width: 100%;
    }
    .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 5rem 2rem 2rem;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    h1 {
        margin: 0;
    }
    h2 {
        font-size: 1.5rem;
        overflow-wrap: anywhere;
    }
    h3 {
        font-size: 1rem;
        font-weight: 600;
    }
    .meta {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.875rem;
        line-height: 1.5;
    }
    .grid {
        display: grid;
        gap: 1rem;
    }
    #results {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .kpis {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    }
    .charts {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    }
    cds-tile {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-width: 0;
    }
    .label {
        font-weight: 600;
    }
    .value {
        font-size: 1.75rem;
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
    }
    .chart {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .plot {
        position: relative;
        height: 10rem;
        cursor: crosshair;
        outline-offset: 4px;
    }
    svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    svg :global(.chart-grid) {
        stroke: var(--cds-border-subtle, #e0e0e0);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    svg :global(.chart-line) {
        fill: none;
        stroke: var(--cds-link-primary, #0f62fe);
        stroke-width: 2;
        vector-effect: non-scaling-stroke;
    }
    svg :global(.chart-point) {
        fill: var(--cds-link-primary, #0f62fe);
    }
    .axis {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.75rem;
    }
    .axis-end {
        text-align: right;
    }
    .hover-dot {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--cds-link-primary, #0f62fe);
        border: 2px solid var(--cds-layer-01, #f4f4f4);
        transform: translate(-50%, -50%);
        pointer-events: none;
    }
    .hover-line {
        position: absolute;
        top: 0;
        bottom: 0;
        border-left: 1px dashed var(--cds-text-secondary, #525252);
        pointer-events: none;
    }
    .chart-tooltip {
        position: absolute;
        z-index: 2;
        pointer-events: none;
        width: max-content;
        max-width: min(17rem, 100%);
        box-sizing: border-box;
        padding: 0.5rem 0.75rem;
        color: var(--cds-text-inverse, #fff);
        background: var(--cds-background-inverse, #393939);
        box-shadow: 0 2px 6px #0003;
    }
    .inspection {
        margin: 0;
        font-size: 0.75rem;
        line-height: 1.5;
        font-variant-numeric: tabular-nums;
    }
    #dashboard-error {
        border-left: 3px solid var(--cds-support-error, #da1e28);
        padding: 1rem;
    }
    [hidden] {
        display: none !important;
    }
    #status:empty {
        display: none;
    }
    summary {
        cursor: pointer;
        padding: 0.75rem 0;
    }
    .table-wrap {
        overflow: auto;
        max-height: 24rem;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    th,
    table :global(td) {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        white-space: nowrap;
    }
    th {
        font-weight: 600;
    }
    caption {
        text-align: left;
        padding: 0.75rem;
    }
    @media (max-width: 600px) {
        .content {
            padding: 4.5rem 1rem 2rem;
        }
    }
</style>
<script>
    import "@carbon/web-components/es/components/ui-shell/index.js";
    import "@carbon/web-components/es/components/tile/index.js";
    import "@carbon/web-components/es/components/link/index.js";
    import "@carbon/web-components/es/components/button/index.js";
    import { logout, requireLicense } from "../lib/auth";
    import { initDashboard } from "../lib/dashboard";
    document.getElementById("logout")?.addEventListener("click", logout);
    requireLicense().then((user) => {
        if (user) void initDashboard();
    });
</script>
