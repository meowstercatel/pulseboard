---
import AuthLayout from "../layouts/AuthLayout.astro";
import Field from "../components/Field.astro";
---

<AuthLayout title="Verify your email">
    <p id="status" role="status" aria-live="polite">
        Checking your account…
    </p>

    <div id="pending" hidden>
        <p>
            We sent a verification link to <strong id="email"></strong>. Open it
            to finish setting up your account.
        </p>
        <form id="resend-form">
            <cds-inline-notification
                kind="error"
                title="Couldn't resend"
                hide-close-button
                hidden
            ></cds-inline-notification>
            <cds-button kind="secondary">Resend email</cds-button>
        </form>
        <p>
            Wrong address? <cds-link href="/settings">Change it</cds-link> or
            <cds-link id="logout" href="/">
                Log out
            </cds-link>
        </p>
    </div>

    <div id="failed" hidden>
        <cds-inline-notification
            kind="error"
            title="Couldn't verify your email"
            hide-close-button
            open
        ></cds-inline-notification>
        <p>
            <cds-link id="request-link" href="/verify-email">
                Request a new link
            </cds-link>
        </p>
    </div>

    <div id="confirm" hidden>
        <form id="confirm-form" method="post" novalidate>
            <p>
                This account was set up with a password. Enter it to finish
                verifying <strong id="confirm-email"></strong> and sign in.
            </p>
            <!-- tells password managers which account the password is for -->
            <input
                id="confirm-username"
                name="email"
                type="email"
                autocomplete="username"
                hidden
            />
            <Field
                id="confirm-password"
                label="Password"
                name="password"
                type="password"
                autocomplete="current-password"
            />
            <p class="forgot">
                <cds-link href="/forgot-password">Forgot password?</cds-link>
            </p>
            <cds-inline-notification
                kind="error"
                title="Couldn't verify your email"
                hide-close-button
                hidden
            ></cds-inline-notification>
            <button class="button" type="submit" disabled>
                Verify and sign in
            </button>
        </form>
        <form id="not-mine-form">
            <p>
                Didn't create this account? Someone else may have signed up with
                your address. We'll verify it for you, sign everyone out of the
                account, make its password stop working and email you a link to
                choose your own.
            </p>
            <cds-inline-notification
                kind="error"
                title="Couldn't secure the account"
                hide-close-button
                hidden
            ></cds-inline-notification>
            <cds-button kind="secondary">
                I didn't create this account
            </cds-button>
        </form>
    </div>

    <div id="disowned" hidden>
        <p id="disowned-message"></p>
        <p>
            No email?{" "}
            <cds-link href="/forgot-password">Request a new link</cds-link>
        </p>
    </div>

    <div id="done" hidden>
        <p id="verified-message">Your email address is verified.</p>
        <cds-button id="continue" href="/buy">
            Continue
        </cds-button>
    </div>
</AuthLayout>

<style>
    #pending,
    #failed,
    #confirm,
    #disowned,
    #done,
    #confirm form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    #pending[hidden],
    #failed[hidden],
    #confirm[hidden],
    #disowned[hidden],
    #done[hidden] {
        display: none;
    }
    #confirm {
        gap: 2.5rem;
    }
    .forgot {
        margin-top: -0.5rem;
    }
    #failed {
        padding-block: 0.5rem;
    }
</style>

<script>
    import {
        accountDestination,
        currentUser,
        disownAccount,
        disownedMessage,
        logout,
        resendVerificationEmail,
        verifiedStep,
        verifyEmail,
        type User,
    } from "../lib/auth";
    import { bindForm } from "../lib/form";

    const status = document.getElementById("status")!;
    const STATES = [
        "pending",
        "failed",
        "confirm",
        "disowned",
        "done",
    ] as const;
    const show = (id: (typeof STATES)[number]) => {
        status.hidden = true;
        for (const state of STATES) {
            document.getElementById(state)!.hidden = state !== id;
        }
    };

    function done(user: User | null, message: string, href?: string) {
        document.getElementById("verified-message")!.textContent = message;
        document
            .getElementById("continue")!
            .setAttribute(
                "href",
                href ?? (user ? accountDestination(user) : "/login"),
            );
        show("done");
    }

    async function failed(error: string) {
        const user = await currentUser();
        const request = document.getElementById("request-link")!;
        request.setAttribute("href", user ? "/verify-email" : "/login");
        request.textContent = user
            ? "Request a new link"
            : "Log in to request a new link";
        const notification = document.querySelector(
            "#failed cds-inline-notification",
        ) as HTMLElement & { subtitle: string };
        notification.subtitle = error;
        show("failed");
    }

    // The account has a password and this isn't its session: the link only
    // finishes once the password is entered, or the clicker says the account
    // isn't theirs. The link keeps working until then.
    function confirm(token: string, email: string) {
        document.getElementById("confirm-email")!.textContent = email;
        (
            document.getElementById("confirm-username") as HTMLInputElement
        ).value = email;
        show("confirm");
        document.getElementById("confirm-password")!.focus();

        bindForm(
            document.getElementById("confirm-form") as HTMLFormElement,
            async (field) => {
                const result = await verifyEmail(token, field("password"));
                if ("confirm" in result) {
                    // the password changed since the page asked for it
                    return "The password has changed. Enter the new one";
                }
                if ("error" in result) {
                    if (result.status === 400) await failed(result.error);
                    return result.error;
                }
                const { message, href } = verifiedStep(result);
                done(result.user, message, href);
                return null;
            },
        );
        bindForm(
            document.getElementById("not-mine-form") as HTMLFormElement,
            async () => {
                const result = await disownAccount(token);
                if ("error" in result) {
                    if (result.status === 400) await failed(result.error);
                    return result.error;
                }
                document.getElementById("disowned-message")!.textContent =
                    disownedMessage(result);
                show("disowned");
                return null;
            },
        );
    }

    async function fromLink(token: string) {
        // keep the token out of the history and the Referer header
        history.replaceState(null, "", "/verify-email");
        status.textContent = "Verifying your email address…";
        const result = await verifyEmail(token);
        if ("confirm" in result) return confirm(token, result.email);
        if ("error" in result) {
            const user = await currentUser();
            if (result.status === 400 && user?.emailVerified) {
                done(
                    user,
                    "The account you’re signed in to already has a verified email address. You can continue without using this link.",
                );
                return;
            }
            return failed(result.error);
        }
        // the link signs this browser in to the account it verified
        const { message, href } = verifiedStep(result);
        done(result.user, message, href);
    }

    async function waiting() {
        const user = await currentUser();
        if (!user) return location.replace("/login");
        if (user.emailVerified) {
            done(
                user,
                "Your email address is already verified. You can continue.",
            );
            return;
        }
        document.getElementById("email")!.textContent = user.email;
        show("pending");
    }

    const token = new URLSearchParams(location.search).get("token");
    if (token) fromLink(token);
    else waiting();

    document.getElementById("logout")!.addEventListener("click", (e) => {
        e.preventDefault();
        logout();
    });

    bindForm(
        document.getElementById("resend-form") as HTMLFormElement,
        async () => {
            const user = await currentUser();
            if (user?.emailVerified) {
                done(
                    user,
                    "Your email address is already verified. You can continue.",
                );
                return null;
            }
            const error = await resendVerificationEmail();
            if (error) return error;
            status.textContent = "Sent! Check your inbox.";
            status.hidden = false;
            return null;
        },
    );
</script>
