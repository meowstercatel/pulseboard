---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
import Field from "../components/Field.astro";
import AppHeader from "../components/AppHeader.astro";
import { MAX_PASSWORD, MIN_PASSWORD } from "../lib/passwordStrength";
---

<HtmlTemplate title="Account settings · PulseBoard" requiresAuth>
    <main>
        <AppHeader />
        <div class="content">
            <div class="page-header">
                <div>
                    <h1>Account settings</h1>
                    <p class="meta">Manage your profile and sign-in details.</p>
                    <p class="meta" id="signed-in"></p>
                </div>
            </div>
            <p id="loading" role="status">
                Loading your account…
            </p>
            <noscript>Enable JavaScript to manage your account.</noscript>

            <div id="settings" hidden>
                <nav class="settings-nav" aria-label="Settings sections">
                    <ul>
                        <li>
                            <a href="#profile" data-panel-link>
                                Profile
                            </a>
                        </li>
                        <li>
                            <a href="#password" data-panel-link>
                                Password
                            </a>
                        </li>
                        <li>
                            <a href="#connected-accounts" data-panel-link>
                                Connected accounts
                            </a>
                        </li>
                        <li>
                            <a href="#sessions" data-panel-link>
                                Devices
                            </a>
                        </li>
                        <li>
                            <a href="#plan" data-panel-link>
                                Plan
                            </a>
                        </li>
                        <li>
                            <a href="#delete-account" data-panel-link>
                                Delete account
                            </a>
                        </li>
                    </ul>
                </nav>
                <div class="panels">
                    <section
                        class="panel"
                        data-panel
                        id="profile"
                        aria-labelledby="profile-heading"
                    >
                        <h2 id="profile-heading">Profile</h2>
                        <p class="description">
                            Your email address is used to log in.
                        </p>
                        <form id="profile-form" method="post" novalidate>
                            <!-- a display name: the email is what you log in with -->
                            <Field
                                id="profile-username"
                                label="Username (optional)"
                                name="username"
                                autocomplete="nickname"
                            />
                            <Field
                                id="profile-email"
                                label="Email"
                                name="email"
                                type="email"
                                autocomplete="username"
                                required
                            />
                            <Field
                                id="profile-current-password"
                                label="Current password"
                                name="currentPassword"
                                type="password"
                                autocomplete="current-password"
                                helper="Needed to change your email address."
                                hidden
                            />
                            <cds-inline-notification
                                kind="error"
                                title="Couldn't save profile"
                                hide-close-button
                                hidden
                            ></cds-inline-notification>
                            <p
                                class="success"
                                id="profile-success"
                                role="status"
                                aria-live="polite"
                            ></p>
                            <button class="button" type="submit" disabled>
                                Save profile
                            </button>
                        </form>
                    </section>
                    <section
                        class="panel"
                        data-panel
                        id="password"
                        aria-labelledby="password-heading"
                    >
                        <h2 id="password-heading">Password</h2>
                        <p class="description" id="password-description">
                            Changing your password signs you out on other
                            devices.
                        </p>
                        <div id="set-password" hidden>
                            <p class="description">
                                You log in with Google or Facebook. To also log
                                in with your email, we'll email you a link to
                                set a password.
                            </p>
                            <cds-inline-notification
                                kind="error"
                                title="Couldn't send the link"
                                hide-close-button
                                hidden
                            ></cds-inline-notification>
                            <p
                                class="success"
                                role="status"
                                aria-live="polite"
                            ></p>
                            <cds-button id="send-setup" type="button">
                                Email me a link to set a password
                            </cds-button>
                        </div>
                        <form id="password-form" method="post" novalidate>
                            <!-- tells password managers which login to update -->
                            <input
                                id="password-username"
                                name="email"
                                type="email"
                                autocomplete="username"
                                data-account-email
                                hidden
                            />
                            <Field
                                id="password-current"
                                label="Current password"
                                name="currentPassword"
                                type="password"
                                autocomplete="current-password"
                                required
                            />
                            <Field
                                id="password-new"
                                label="New password"
                                name="newPassword"
                                type="password"
                                autocomplete="new-password"
                                helper={`${MIN_PASSWORD}–${MAX_PASSWORD} characters.`}
                                required
                                strength
                            />
                            <Field
                                id="password-confirm"
                                label="Confirm new password"
                                name="confirm"
                                type="password"
                                autocomplete="new-password"
                                required
                            />
                            <cds-inline-notification
                                kind="error"
                                title="Couldn't change password"
                                hide-close-button
                                hidden
                            ></cds-inline-notification>
                            <p
                                class="success"
                                id="password-success"
                                role="status"
                                aria-live="polite"
                            ></p>
                            <button class="button" type="submit" disabled>
                                Change password
                            </button>
                        </form>
                    </section>
                    <section
                        class="panel"
                        data-panel
                        id="connected-accounts"
                        aria-labelledby="connected-heading"
                    >
                        <h2 id="connected-heading">Connected accounts</h2>
                        <p class="description">
                            Google and Facebook accounts you can log in with.
                        </p>
                        <ul
                            class="accounts"
                            aria-label="Connected accounts"
                        ></ul>
                        <cds-inline-notification
                            kind="error"
                            title="Couldn't update connected accounts"
                            hide-close-button
                            hidden
                        ></cds-inline-notification>
                        <p class="success" role="status" aria-live="polite"></p>
                        <Field
                            id="connected-current-password"
                            label="Current password"
                            name="currentPassword"
                            type="password"
                            autocomplete="current-password"
                            helper="Required to connect or disconnect an account."
                            hidden
                        />
                        <div class="connect" hidden>
                            <div class="connect-buttons"></div>
                        </div>
                    </section>
                    <section
                        class="panel"
                        data-panel
                        id="sessions"
                        aria-labelledby="sessions-heading"
                    >
                        <h2 id="sessions-heading">Devices</h2>
                        <p class="description">
                            Sign out any device you don't recognize, then change
                            your password.
                        </p>
                        <ul
                            class="sessions"
                            aria-label="Signed-in devices"
                        ></ul>
                        <cds-inline-notification
                            kind="error"
                            title="Couldn't update sessions"
                            hide-close-button
                            hidden
                        ></cds-inline-notification>
                        <p class="success" role="status" aria-live="polite"></p>
                        <cds-button
                            id="revoke-others"
                            type="button"
                            kind="tertiary"
                            disabled
                        >
                            Log out everywhere else
                        </cds-button>
                    </section>
                    <section
                        class="panel"
                        data-panel
                        id="plan"
                        aria-labelledby="plan-heading"
                    >
                        <h2 id="plan-heading">Plan</h2>
                        <p class="description" id="plan-status"></p>
                        <cds-link href="/buy" id="plan-link">
                            Choose a plan
                        </cds-link>
                    </section>
                    <section
                        class="panel danger"
                        data-panel
                        id="delete-account"
                        aria-labelledby="delete-heading"
                    >
                        <h2 id="delete-heading">Delete account</h2>
                        <p class="description">
                            Permanently deletes your account, datasets and
                            metrics, and signs you out everywhere. This can't be
                            undone.
                        </p>
                        <cds-button
                            id="open-delete"
                            type="button"
                            kind="danger"
                        >
                            Delete my account
                        </cds-button>
                        <dialog
                            id="delete-confirmation"
                            aria-labelledby="delete-modal-heading"
                            aria-describedby="delete-modal-description"
                        >
                            <header class="modal-header">
                                <h2 id="delete-modal-heading">
                                    Delete your account?
                                </h2>
                                <button
                                    id="close-delete"
                                    type="button"
                                    aria-label="Close account deletion dialog"
                                >
                                    ×
                                </button>
                            </header>
                            <p
                                id="delete-modal-description"
                                class="description"
                            >
                                Your account, saved datasets, and metrics will
                                be permanently deleted. You will lose license
                                access and be signed out on every device. This
                                cannot be undone.
                            </p>
                            <form id="delete-form" method="post" novalidate>
                                <Field
                                    id="delete-confirmation-text"
                                    label='Type "delete my account" to confirm'
                                    name="confirmation"
                                    autocomplete="off"
                                    spellcheck={false}
                                    required
                                />
                                <input
                                    id="delete-username"
                                    name="email"
                                    type="email"
                                    autocomplete="username"
                                    data-account-email
                                    hidden
                                />
                                <Field
                                    id="delete-current-password"
                                    label="Current password"
                                    name="currentPassword"
                                    type="password"
                                    autocomplete="current-password"
                                    helper="If you only sign in with Google or Facebook, leave this empty and sign in again first."
                                />
                                <cds-inline-notification
                                    kind="error"
                                    title="Couldn't delete account"
                                    hide-close-button
                                    hidden
                                ></cds-inline-notification>
                                <div class="modal-actions">
                                    <button id="cancel-delete" type="button">
                                        Cancel
                                    </button>
                                    <button
                                        class="button button-danger"
                                        type="submit"
                                        disabled
                                    >
                                        Permanently delete account
                                    </button>
                                </div>
                            </form>
                        </dialog>
                    </section>
                </div>
            </div>
        </div>
    </main>
</HtmlTemplate>

<style>
    main {
        width: 100%;
    }
    .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 5rem 2rem 2rem;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    h1 {
        margin: 0;
    }
    h2 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }
    #signed-in {
        overflow-wrap: anywhere;
    }
    #signed-in:empty {
        display: none;
    }
    .meta,
    .description {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.875rem;
        line-height: 1.5;
    }
    /* one panel at a time, picked from the list on the left */
    #settings {
        display: grid;
        grid-template-columns: 14rem minmax(0, 40rem);
        align-items: start;
        gap: 2rem;
    }
    .settings-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .settings-nav a {
        display: block;
        padding: 0.75rem 1rem;
        border-left: 3px solid transparent;
        color: var(--cds-text-secondary, #525252);
        font-size: 0.875rem;
        text-decoration: none;
    }
    .settings-nav a:hover {
        background: var(--cds-layer-hover-01, #e8e8e8);
        color: var(--cds-text-primary, #161616);
    }
    .settings-nav a[aria-current="true"] {
        border-left-color: var(--cds-border-interactive, #0f62fe);
        background: var(--cds-layer-selected-01, #e0e0e0);
        color: var(--cds-text-primary, #161616);
        font-weight: 600;
    }
    .settings-nav a:focus-visible {
        outline: 2px solid var(--cds-focus, #0f62fe);
        outline-offset: -2px;
    }
    section {
        padding: 1.5rem;
        background: var(--cds-layer-01, #f4f4f4);
        /* inputs on the grey layer are white, as in Carbon */
        --pulse-field: var(--cds-field-02, #fff);
    }
    .description {
        margin-bottom: 1.5rem;
    }
    form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    cds-button,
    .button {
        align-self: flex-start;
    }
    cds-inline-notification {
        max-width: 100%;
    }
    .success {
        color: var(--cds-text-primary, #161616);
        font-size: 0.875rem;
        border-left: 3px solid var(--cds-support-success, #24a148);
        padding-left: 0.75rem;
    }
    .success:empty,
    [hidden] {
        display: none !important;
    }
    .sessions {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
    }
    .sessions:empty {
        display: none;
    }
    .sessions :global(li) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
    .sessions :global(li:first-child) {
        padding-top: 0;
    }
    .sessions :global(.device) {
        font-size: 0.875rem;
        font-weight: 600;
        overflow-wrap: anywhere;
    }
    .sessions :global(.meta) {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.75rem;
        margin-top: 0.25rem;
        overflow-wrap: anywhere;
    }
    .sessions :global(.visually-hidden) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
    .sessions :global(cds-button) {
        flex-shrink: 0;
    }
    .accounts {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
    }
    .accounts:empty {
        display: none;
    }
    .accounts :global(li) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
    }
    .accounts :global(li:first-child) {
        padding-top: 0;
    }
    .accounts :global(.provider) {
        font-size: 0.875rem;
        font-weight: 600;
    }
    .accounts :global(.meta) {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.75rem;
        margin-top: 0.25rem;
        overflow-wrap: anywhere;
    }
    .accounts :global(.visually-hidden) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
    .accounts :global(cds-button) {
        flex-shrink: 0;
    }
    .connect {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .connect-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    #connected-accounts > :global(.field) {
        margin-bottom: 1rem;
    }
    #connected-accounts .success,
    #connected-accounts cds-inline-notification,
    #set-password .success,
    #set-password cds-inline-notification {
        margin-bottom: 1rem;
    }
    #sessions .success {
        margin-bottom: 1rem;
    }
    #sessions cds-inline-notification {
        margin-bottom: 1rem;
    }
    .danger {
        border-top: 2px solid var(--cds-support-error, #da1e28);
    }
    dialog {
        box-sizing: border-box;
        width: min(36rem, calc(100vw - 2rem));
        max-height: calc(100dvh - 2rem);
        margin: auto;
        padding: 1.5rem;
        border: 0;
        overflow-y: auto;
        background: var(--cds-layer-01, #f4f4f4);
        color: var(--cds-text-primary, #161616);
        --pulse-field: var(--cds-field-02, #fff);
    }
    dialog::backdrop {
        background: rgba(22, 22, 22, 0.6);
    }
    .modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.5rem;
    }
    #cancel-delete,
    #close-delete {
        background: none;
        border: 0;
        padding: 0.5rem;
        color: var(--cds-link-primary, #0f62fe);
        font: inherit;
        cursor: pointer;
    }
    #close-delete {
        color: var(--cds-text-primary, #161616);
        font-size: 1.5rem;
        line-height: 1;
    }
    #cancel-delete:disabled,
    #close-delete:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    #cancel-delete:focus-visible,
    #close-delete:focus-visible {
        outline: 2px solid var(--cds-focus, #0f62fe);
        outline-offset: 2px;
    }
    /* the list becomes a row of tabs above the panel */
    @media (max-width: 42rem) {
        #settings {
            grid-template-columns: minmax(0, 1fr);
            gap: 1rem;
        }
        .settings-nav {
            overflow-x: auto;
            border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        }
        .settings-nav ul {
            display: flex;
        }
        .settings-nav a {
            padding: 0.75rem 1rem;
            border-left: 0;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
        }
        .settings-nav a[aria-current="true"] {
            border-bottom-color: var(--cds-border-interactive, #0f62fe);
            background: none;
        }
    }
    @media (max-width: 600px) {
        .content {
            padding: 4.5rem 1rem 2rem;
        }
    }
    @media (max-width: 400px) {
        section {
            padding: 1rem;
        }
    }
</style>

<script>
    import "@carbon/web-components/es/components/button/index.js";
    import "@carbon/web-components/es/components/notification/index.js";
    import "@carbon/web-components/es/components/link/index.js";
    import "@carbon/web-components/es/components/tag/index.js";
    import {
        changePassword,
        deleteAccount,
        hasAccess,
        requireUser,
        updateProfile,
    } from "../lib/auth";
    import { planSummary, showTrialBadge } from "../lib/plan";
    import { bindForm } from "../lib/form";
    import { clearField } from "../lib/passwordField";
    import { MAX_PASSWORD, MIN_PASSWORD } from "../lib/passwordStrength";
    import { mountSessions } from "../lib/sessions";
    import {
        linkResult,
        mountConnectedAccounts,
        requestPasswordSetup,
    } from "../lib/connectedAccounts";

    const profileForm = document.getElementById(
        "profile-form",
    ) as HTMLFormElement;
    const passwordForm = document.getElementById(
        "password-form",
    ) as HTMLFormElement;
    const profileSuccess = document.getElementById("profile-success")!;
    const passwordSuccess = document.getElementById("password-success")!;
    const input = (form: HTMLFormElement, name: string) =>
        form.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
    // the hidden username fields of the password and delete forms
    const showAccountEmail = (email: string) => {
        document
            .querySelectorAll<HTMLInputElement>("[data-account-email]")
            .forEach((field) => {
                field.value = email;
            });
    };
    let savedEmail = "";
    const showSignedIn = (email: string) => {
        document.getElementById("signed-in")!.textContent =
            `Signed in as ${email}`;
    };
    // the current password is only asked for once the email is changed
    const emailPassword = input(profileForm, "currentPassword");
    const showEmailPassword = () => {
        const changed =
            input(profileForm, "email").value.trim().toLowerCase() !==
            savedEmail;
        if (!changed && emailPassword.value) clearField(emailPassword);
        emailPassword.closest<HTMLElement>(".field")!.hidden = !changed;
    };

    // One section at a time. The URL hash names it, so links to a section
    // and the back button work.
    const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
    const panelLinks = [
        ...document.querySelectorAll<HTMLAnchorElement>("[data-panel-link]"),
    ];
    let defaultPanel = "profile";
    const showPanel = () => {
        if (deleteDialog.open) {
            // a deletion in progress keeps its dialog and panel
            if (deleting) {
                history.replaceState(null, "", "#delete-account");
                return;
            }
            deleteDialog.close();
        }
        const id = location.hash.slice(1) || defaultPanel;
        const current =
            panels.find((panel) => panel.id === id) ??
            panels.find((panel) => panel.id === defaultPanel)!;
        for (const panel of panels) panel.hidden = panel !== current;
        for (const link of panelLinks) {
            if (link.hash === `#${current.id}`)
                link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
        }
    };
    for (const link of panelLinks) {
        link.addEventListener("click", (event) => {
            if (
                event.button !== 0 ||
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey
            )
                return;
            event.preventDefault();
            // without the jump to the anchor
            if (location.hash !== link.hash)
                history.pushState(null, "", link.hash);
            showPanel();
        });
    }
    window.addEventListener("hashchange", showPanel);
    const deleteForm = document.getElementById(
        "delete-form",
    ) as HTMLFormElement;
    const cancelDelete = document.getElementById(
        "cancel-delete",
    ) as HTMLButtonElement;
    const deleteDialog = document.getElementById(
        "delete-confirmation",
    ) as HTMLDialogElement;
    const openDelete = document.getElementById("open-delete")!;
    const closeDelete = document.getElementById(
        "close-delete",
    ) as HTMLButtonElement;
    let deleting = false;
    openDelete.addEventListener("click", () => {
        deleteDialog.showModal();
        input(deleteForm, "confirmation").focus();
    });
    const dismissDeletion = () => {
        if (!deleting) deleteDialog.close();
    };
    cancelDelete.addEventListener("click", dismissDeletion);
    closeDelete.addEventListener("click", dismissDeletion);
    deleteDialog.addEventListener("cancel", (event) => {
        if (deleting) event.preventDefault();
    });
    deleteDialog.addEventListener("close", () => {
        clearField(input(deleteForm, "confirmation"));
        clearField(input(deleteForm, "currentPassword"));
        updateDeleteButton();
        deleteForm.querySelector<HTMLElement>(
            "cds-inline-notification",
        )!.hidden = true;
        openDelete.shadowRoot?.querySelector("button")?.focus();
    });

    const sessions = mountSessions(document.getElementById("sessions")!);

    // Social-only accounts are offered a link to set a password instead of
    // the change password form
    const setPassword = document.getElementById("set-password")!;
    const connected = mountConnectedAccounts(
        document.getElementById("connected-accounts")!,
        ({ hasPassword }) => {
            passwordForm.hidden = !hasPassword;
            document.getElementById("password-description")!.hidden =
                !hasPassword;
            setPassword.hidden = hasPassword;
        },
    );
    // set by the server when a Google/Facebook connection finishes
    const linked = linkResult(new URLSearchParams(location.search));
    if (linked) {
        connected.showResult(linked);
        history.replaceState(null, "", "/settings#connected-accounts");
    }

    const sendSetup = setPassword.querySelector<
        HTMLElement & { disabled: boolean }
    >("#send-setup")!;
    const setupError = setPassword.querySelector<
        HTMLElement & { subtitle: string }
    >("cds-inline-notification")!;
    const setupStatus = setPassword.querySelector<HTMLElement>(".success")!;
    sendSetup.addEventListener("click", async () => {
        if (sendSetup.disabled) return;
        sendSetup.disabled = true;
        setupError.hidden = true;
        setupStatus.textContent = "";
        const result = await requestPasswordSetup();
        sendSetup.disabled = false;
        if ("error" in result) {
            setupError.subtitle = result.error;
            setupError.hidden = false;
        } else {
            setupStatus.textContent = `We sent a link to ${savedEmail}. It expires in 1 hour.`;
        }
    });

    profileForm.addEventListener("input", () => {
        profileSuccess.textContent = "";
        showEmailPassword();
    });
    passwordForm.addEventListener("input", () => {
        passwordSuccess.textContent = "";
    });

    requireUser().then((user) => {
        if (!user) return;
        savedEmail = user.email;
        showAccountEmail(user.email);
        input(profileForm, "username").value = user.username ?? "";
        input(profileForm, "email").value = user.email;
        showSignedIn(user.email);
        const plan = planSummary(user);
        document.getElementById("plan-status")!.textContent = plan.text;
        document.getElementById("plan-link")!.textContent = plan.action;
        showTrialBadge(user);
        // without a license or trial the dashboard would only send them on to
        // /buy, and the plan is what they came for
        if (!hasAccess(user)) {
            defaultPanel = "plan";
            document.getElementById("brand")!.setAttribute("href", "/buy");
            document
                .querySelectorAll<HTMLElement>("[data-dashboard-link]")
                .forEach((link) => {
                    link.hidden = true;
                });
        }
        showPanel();
        document.getElementById("loading")!.hidden = true;
        document.getElementById("settings")!.hidden = false;
        sessions.load();
        connected.load();
    });

    bindForm(profileForm, async (field) => {
        profileSuccess.textContent = "";
        const email = field("email").trim().toLowerCase();
        if (
            !/^[^\s@,;:<>()"\[\]\\]+@[^\s@,;:<>()"\[\]\\]+\.[^\s@,;:<>()"\[\]\\]+$/.test(
                email,
            )
        ) {
            return "Enter a valid email address";
        }
        if (email !== savedEmail && !field("currentPassword")) {
            return "Enter your current password to change your email";
        }
        const result = await updateProfile(
            field("username"),
            email,
            field("currentPassword"),
        );
        if ("error" in result) return result.error;
        savedEmail = result.user.email;
        showAccountEmail(result.user.email);
        showSignedIn(result.user.email);
        input(profileForm, "username").value = result.user.username ?? "";
        input(profileForm, "email").value = result.user.email;
        showEmailPassword();
        // a new email signs out other devices
        sessions.load();
        profileSuccess.textContent = result.user.emailVerified
            ? "Profile saved."
            : `Profile saved. We sent a verification link to ${result.user.email}.`;
        return null;
    });

    bindForm(passwordForm, async (field) => {
        passwordSuccess.textContent = "";
        if (!field("currentPassword")) return "Enter your current password";
        const password = field("newPassword");
        if (password.length < MIN_PASSWORD || password.length > MAX_PASSWORD) {
            return `New password must be ${MIN_PASSWORD}–${MAX_PASSWORD} characters`;
        }
        if (password !== field("confirm")) return "Passwords don't match";
        const result = await changePassword(field("currentPassword"), password);
        if ("error" in result) return result.error;
        passwordForm
            .querySelectorAll<HTMLInputElement>(".field input")
            .forEach(clearField);
        clearField(input(profileForm, "currentPassword"));
        passwordSuccess.textContent =
            "Password changed. Other devices have been signed out.";
        sessions.load();
        return null;
    });

    const updateDeleteButton = bindForm(
        deleteForm,
        async (field) => {
            const confirmation = field("confirmation").trim().toLowerCase();
            if (confirmation !== "delete my account")
                return 'Type "delete my account" to confirm deletion';
            deleting = true;
            cancelDelete.disabled = true;
            closeDelete.disabled = true;
            const result = await deleteAccount(
                confirmation,
                field("currentPassword"),
            );
            if ("error" in result) {
                deleting = false;
                cancelDelete.disabled = false;
                closeDelete.disabled = false;
                return result.error;
            }
            location.replace("/");
            return null;
        },
        () =>
            !deleting &&
            input(deleteForm, "confirmation").value.trim().toLowerCase() ===
                "delete my account",
    );
</script>
