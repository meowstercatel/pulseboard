---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";
import AppHeader from "../components/AppHeader.astro";
import DashboardControls from "../components/DashboardControls.astro";
import { metricFields } from "../lib/dashboardControls";
import { horizons } from "../lib/forecastPage";
import { limits } from "../lib/limits";
---

<HtmlTemplate title="Forecast · PulseBoard" requiresAuth>
    <main>
        <AppHeader />
        <section class="content">
            <div class="page-header">
                <div>
                    <h1>Forecast</h1>
                    <p class="meta">All times are UTC.</p>
                </div>
            </div>
            <noscript>Enable JavaScript to view forecasts.</noscript>
            <DashboardControls range={false} />
            <cds-tile>
                <div class="selects">
                    <div class="field">
                        <label for="metric">Metric</label>
                        <select id="metric" data-reloads-selection>
                            {metricFields.map(([value, label]) => (
                                <option value={value}>{label}</option>
                            ))}
                        </select>
                    </div>
                    <div class="field">
                        <label for="horizon">Forecast ahead</label>
                        <select id="horizon" data-reloads-selection>
                            {Object.entries(horizons).map(([value, label]) => (
                                <option value={value} selected={value === "7d"}>
                                    {label}
                                </option>
                            ))}
                        </select>
                    </div>
                </div>
            </cds-tile>
            <p id="status" role="status" aria-live="polite">
                Loading datasets…
            </p>
            <p id="dashboard-error" role="alert" hidden></p>
            <cds-button id="retry" kind="secondary" size="sm" hidden>
                Retry
            </cds-button>
            <div id="results" hidden>
                <div class="page-header">
                    <h2 id="selection-title"></h2>
                    <p class="meta" id="summary"></p>
                </div>
                <cds-tile>
                    <ul class="legend meta">
                        <li>
                            <span class="key avg" aria-hidden="true"></span>
                            History, hourly average
                        </li>
                        <li>
                            <span
                                class="key forecast"
                                aria-hidden="true"
                            ></span>
                            Forecast
                        </li>
                        <li>
                            <span class="key area" aria-hidden="true"></span>
                            <span id="band-label"></span>
                        </li>
                        <li>
                            <span class="key band" aria-hidden="true"></span>
                            No readings
                        </li>
                    </ul>
                    <div class="history-chart" id="chart"></div>
                    <details>
                        <summary>View as table</summary>
                        <div class="table-wrap">
                            <table>
                                <caption id="chart-caption"></caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Hour (UTC)</th>
                                        <th scope="col">Forecast</th>
                                        <th scope="col">Lower</th>
                                        <th scope="col">Upper</th>
                                    </tr>
                                </thead>
                                <tbody id="chart-rows"></tbody>
                            </table>
                        </div>
                    </details>
                    <div id="model"></div>
                    <p class="meta" id="note"></p>
                </cds-tile>
            </div>
            <cds-tile id="capacity" hidden>
                <h3>Disk and RAM capacity</h3>
                <p class="meta">
                    Every host in the dataset, {limits.capacityDays} days past
                    its latest reading, soonest first.
                </p>
                <p id="capacity-status" role="status"></p>
                <div class="table-wrap" id="capacity-table" hidden>
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Host</th>
                                <th scope="col">Resource</th>
                                <th scope="col">Latest</th>
                                <th scope="col">Reaches 80%</th>
                                <th scope="col">Reaches 90%</th>
                                <th scope="col">Reaches 100%</th>
                            </tr>
                        </thead>
                        <tbody id="capacity-rows"></tbody>
                    </table>
                </div>
                <p class="meta" id="capacity-note"></p>
            </cds-tile>
        </section>
    </main>
</HtmlTemplate>
<style>
    main {
        width: 100%;
    }
    .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 5rem 2rem 2rem;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    h1 {
        margin: 0;
    }
    h2 {
        font-size: 1.5rem;
        overflow-wrap: anywhere;
    }
    h3 {
        font-size: 1rem;
        font-weight: 600;
    }
    .meta {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.875rem;
        line-height: 1.5;
    }
    #results {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    cds-tile {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-width: 0;
    }
    #model {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }
    .selects {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    }
    .field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }
    label {
        font-size: 0.75rem;
        color: var(--cds-text-secondary, #525252);
    }
    select {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        height: 2.5rem;
        padding: 0 0.75rem;
        border: 0;
        border-bottom: 1px solid var(--cds-border-strong, #8d8d8d);
        border-radius: 0;
        background: var(--cds-field-01, #f4f4f4);
        color: var(--cds-text-primary, #161616);
        font: inherit;
        font-size: 0.875rem;
    }
    select:focus {
        outline: 2px solid var(--cds-focus, #0f62fe);
        outline-offset: -2px;
    }

    /* History in blue 60; the forecast dashed in the same hue, its band a tint. */
    .history-chart,
    .legend {
        --avg: #0f62fe;
        --forecast: #0f62fe;
    }
    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.75rem;
    }
    .legend li {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .key {
        display: inline-block;
        width: 1rem;
        flex-shrink: 0;
    }
    .key.avg,
    .key.forecast {
        border-top: 2px solid var(--avg);
    }
    .key.forecast {
        border-top-style: dashed;
    }
    .key.area {
        height: 0.75rem;
        background: rgb(15 98 254 / 0.15);
    }
    .key.band {
        height: 0.75rem;
        background: rgb(198 198 198 / 0.35);
    }

    /* Charts drawn by historyChart.ts */
    .history-chart {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .history-chart :global(.body) {
        display: flex;
        gap: 0.5rem;
    }
    .history-chart :global(.y-axis) {
        position: relative;
        width: 2.75rem;
        flex-shrink: 0;
    }
    .history-chart :global(.y-axis span),
    .history-chart :global(.x-axis span) {
        color: var(--cds-text-secondary, #525252);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .history-chart :global(.y-axis span) {
        position: absolute;
        right: 0;
        transform: translateY(-50%);
    }
    .history-chart :global(.plot) {
        position: relative;
        flex: 1;
        min-width: 0;
        height: 16rem;
        cursor: crosshair;
        outline-offset: 4px;
    }
    .history-chart :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    .history-chart :global(.grid) {
        stroke: var(--cds-border-subtle, #e0e0e0);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    .history-chart :global(.band) {
        fill: #c6c6c6;
        fill-opacity: 0.35;
    }
    .history-chart :global(.area.forecast) {
        fill: var(--forecast);
        fill-opacity: 0.15;
    }
    .history-chart :global(.line) {
        fill: none;
        stroke: var(--avg);
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }
    .history-chart :global(.line.forecast) {
        stroke: var(--forecast);
        stroke-dasharray: 6 4;
        stroke-linecap: butt;
    }
    .history-chart :global(.crosshair) {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--cds-text-secondary, #525252);
        pointer-events: none;
    }
    .history-chart :global(.dot) {
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--avg);
        box-shadow: 0 0 0 2px var(--cds-layer-01, #f4f4f4);
        transform: translate(-50%, -50%);
        pointer-events: none;
    }
    .history-chart :global(.tooltip) {
        position: absolute;
        top: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        padding: 0.375rem 0.625rem;
        background: var(--cds-background-inverse, #393939);
        color: var(--cds-text-inverse, #fff);
        font-size: 0.75rem;
        white-space: nowrap;
        pointer-events: none;
    }
    .history-chart :global(.tooltip-value) {
        font-size: 0.875rem;
        white-space: pre-line;
        font-variant-numeric: tabular-nums;
    }
    .history-chart :global(.x-axis) {
        position: relative;
        height: 1rem;
        margin-inline-start: 3.25rem;
    }
    .history-chart :global(.x-axis span) {
        position: absolute;
        transform: translateX(-50%);
    }
    .history-chart :global(.x-axis span:first-child) {
        transform: none;
    }
    .history-chart :global(.x-axis span:last-child) {
        transform: translateX(-100%);
    }

    #dashboard-error {
        border-left: 3px solid var(--cds-support-error, #da1e28);
        padding: 1rem;
    }
    [hidden],
    .history-chart :global([hidden]) {
        display: none !important;
    }
    #status:empty,
    #capacity-status:empty,
    #note:empty,
    #capacity-note:empty {
        display: none;
    }
    summary {
        cursor: pointer;
        padding: 0.75rem 0;
    }
    .table-wrap {
        overflow: auto;
        max-height: 24rem;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
    }
    th,
    table :global(td),
    table :global(th) {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid var(--cds-border-subtle, #e0e0e0);
        white-space: nowrap;
    }
    th,
    table :global(th) {
        font-weight: 600;
    }
    table :global(tbody th) {
        font-weight: 400;
    }
    caption {
        text-align: left;
        padding: 0.75rem;
    }
    @media (max-width: 600px) {
        .content {
            padding: 4.5rem 1rem 2rem;
        }
    }
</style>
<script>
    import "@carbon/web-components/es/components/tile/index.js";
    import "@carbon/web-components/es/components/button/index.js";
    import { requireLicense } from "../lib/auth";
    import { showTrialBadge } from "../lib/plan";
    import { initForecast } from "../lib/forecastPage";
    requireLicense().then((user) => {
        if (!user) return;
        showTrialBadge(user);
        void initForecast();
    });
</script>
