---
import AuthLayout from "../layouts/AuthLayout.astro";
import Field from "../components/Field.astro";
---

<AuthLayout title="Forgot password">
    <form id="forgot-form" method="post" novalidate>
        <p>
            Enter the email address of your account and we'll send you a link to
            choose a new password.
        </p>
        <Field
            id="forgot-email"
            label="Email"
            name="email"
            type="email"
            autocomplete="username"
        />
        <cds-inline-notification
            kind="error"
            title="Couldn't send the link"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <button class="button" type="submit">
            Send reset link
        </button>
    </form>

    <div id="sent" hidden>
        <p role="status">
            If <strong id="email"></strong> belongs to a PulseBoard account, a
            link to get back in is on its way: one to choose a password, or to
            verify the address if it isn't verified yet.
        </p>
        <p>
            Signed up with Google or Facebook? You can also log in with the
            Google or Facebook button.
        </p>
    </div>

    <p>
        Remember your password? <cds-link href="/login">Log in</cds-link>
    </p>
</AuthLayout>

<style>
    #sent p + p {
        margin-top: 1rem;
    }
</style>

<script>
    import { requestPasswordReset } from "../lib/auth";
    import { bindForm } from "../lib/form";

    const form = document.getElementById("forgot-form") as HTMLFormElement;
    bindForm(form, async (field) => {
        const email = field("email").trim();
        const error = await requestPasswordReset(email);
        if (error) return error;
        document.getElementById("email")!.textContent = email;
        form.hidden = true;
        document.getElementById("sent")!.hidden = false;
        return null;
    });
</script>
