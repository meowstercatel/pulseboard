---
import AuthLayout from "../layouts/AuthLayout.astro";
import Field from "../components/Field.astro";
---

<AuthLayout title="Reset password">
    <form id="reset-form" method="post" novalidate hidden>
        <p id="intro">
            Choose a new password. You'll be signed out on other devices.
        </p>
        <!-- tells password managers which account the new password is for -->
        <input
            id="reset-username"
            name="email"
            type="email"
            autocomplete="username"
            hidden
        />
        <Field
            id="reset-password"
            label="New password"
            name="password"
            type="password"
            autocomplete="new-password"
            helper="At least 8 characters"
            strength
        />
        <Field
            id="reset-confirm"
            label="Repeat password"
            name="confirm"
            type="password"
            autocomplete="new-password"
        />
        <cds-inline-notification
            kind="error"
            title="Couldn't reset your password"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <button class="button" type="submit" disabled>
            Reset password
        </button>
    </form>

    <div id="missing" hidden>
        <cds-inline-notification
            kind="error"
            title="This reset link is incomplete"
            subtitle="Open the link from the email again, or request a new one."
            hide-close-button
            open
        ></cds-inline-notification>
    </div>

    <p>
        Link expired?{" "}
        <cds-link href="/forgot-password">Request a new one</cds-link>
    </p>
</AuthLayout>

<script>
    import { hasAccess, resetPassword } from "../lib/auth";
    import { bindForm } from "../lib/form";

    const params = new URLSearchParams(location.search);
    const token = params.get("token");
    // The emailed link carries the account's address after the #, which is
    // never sent to a server. It only tells password managers which saved
    // login to store the new password under.
    const email = new URLSearchParams(location.hash.slice(1)).get("email");
    // keep the token out of the history and the Referer header
    history.replaceState(null, "", "/reset-password");
    const username = document.getElementById(
        "reset-username",
    ) as HTMLInputElement;
    if (email) username.value = email;

    // a link from "set a password" in the settings: the same reset, worded
    // for an account that has no password yet
    if (params.get("purpose") === "set") {
        document.title = "Set a password · PulseBoard";
        document.getElementById("intro")!.textContent =
            "Choose a password to log in with your email address. You'll be signed out on other devices.";
        const button = document.querySelector(
            "#reset-form button[type=submit]",
        )!;
        button.textContent = "Set password";
        document
            .querySelector("#reset-form cds-inline-notification")!
            .setAttribute("title", "Couldn't set your password");
    }

    const form = document.getElementById("reset-form") as HTMLFormElement;
    if (token) form.hidden = false;
    else document.getElementById("missing")!.hidden = false;

    bindForm(form, async (field) => {
        if (field("password") !== field("confirm")) {
            return "Passwords don't match";
        }
        const result = await resetPassword(token!, field("password"));
        if ("error" in result) return result.error;
        location.href = hasAccess(result.user) ? "/overview" : "/buy";
        return null;
    });
</script>
