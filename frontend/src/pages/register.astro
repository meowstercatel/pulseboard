---
import AuthLayout from "../layouts/AuthLayout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
---

<AuthLayout>
    <form id="register-form">
        <cds-text-input
            label="Email"
            name="email"
            type="email"
            autocomplete="email"
        ></cds-text-input>
        <cds-text-input
            label="Username (optional)"
            name="username"
            autocomplete="username"
        ></cds-text-input>
        <cds-text-input
            label="Password"
            name="password"
            type="password"
            show-password-visibility-toggle
            autocomplete="new-password"
            helper-text="At least 8 characters"
        ></cds-text-input>
        <cds-text-input
            label="Repeat password"
            name="confirm"
            type="password"
            show-password-visibility-toggle
            autocomplete="new-password"
        ></cds-text-input>
        <cds-inline-notification
            kind="error"
            title="Couldn't register"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <cds-button>Register</cds-button>
    </form>
    <div id="sent" hidden>
        <p>
            Check your inbox at <strong id="sent-email"></strong>. Open the link
            we sent to finish setting up your account.
        </p>
    </div>
    <OAuthButtons />
    <p>
        By creating an account you agree to the{" "}
        <cds-link href="/terms">Terms of Service</cds-link> and acknowledge the{" "}
        <cds-link href="/privacy">Privacy Policy</cds-link>
    </p>
    <p>
        Already have an account? <cds-link href="/login">Log in</cds-link>
    </p>
</AuthLayout>

<script>
    import { accountDestination, currentUser, register } from "../lib/auth";
    import { bindForm } from "../lib/form";

    currentUser().then((user) => {
        if (user) location.replace(accountDestination(user));
    });

    bindForm(
        document.getElementById("register-form") as HTMLFormElement,
        async (field) => {
            if (field("password") !== field("confirm")) {
                return "Passwords don't match";
            }
            const email = field("email");
            const error = await register(
                email,
                field("password"),
                field("username"),
            );
            if (error) return error;
            document.getElementById("sent-email")!.textContent = email.trim();
            document.getElementById("register-form")!.hidden = true;
            document.getElementById("sent")!.hidden = false;
            return null;
        },
    );
</script>
