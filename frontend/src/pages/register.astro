---
import AuthLayout from "../layouts/AuthLayout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
---

<AuthLayout title="Create account">
    <form id="register-form">
        <cds-text-input
            label="Email"
            name="email"
            type="email"
            autocomplete="email"
        ></cds-text-input>
        <cds-text-input
            label="Username (optional)"
            name="username"
            autocomplete="username"
        ></cds-text-input>
        <cds-text-input
            label="Password"
            name="password"
            type="password"
            show-password-visibility-toggle
            autocomplete="new-password"
            helper-text="At least 8 characters"
        ></cds-text-input>
        <cds-text-input
            label="Repeat password"
            name="confirm"
            type="password"
            show-password-visibility-toggle
            autocomplete="new-password"
        ></cds-text-input>
        <cds-inline-notification
            kind="error"
            title="Couldn't register"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <cds-button>Create account</cds-button>
    </form>
    <OAuthButtons />
    <p>
        By creating an account you agree to the{" "}
        <cds-link href="/terms">Terms of Service</cds-link> and acknowledge the{" "}
        <cds-link href="/privacy">Privacy Policy</cds-link>
    </p>
    <p>
        Already have an account?{" "}
        <cds-link id="login-link" href="/login">
            Log in
        </cds-link>
    </p>
</AuthLayout>

<script>
    import {
        accountDestination,
        currentUser,
        register,
        safeNext,
    } from "../lib/auth";
    import { bindForm } from "../lib/form";

    // passed on from the login page; dropped once the new account has to
    // verify its email
    const next = safeNext(new URLSearchParams(location.search).get("next"));
    if (next) {
        document
            .getElementById("login-link")!
            .setAttribute("href", `/login?${new URLSearchParams({ next })}`);
    }

    currentUser().then((user) => {
        if (user) location.replace(accountDestination(user, next));
    });

    bindForm(
        document.getElementById("register-form") as HTMLFormElement,
        async (field) => {
            if (field("password") !== field("confirm")) {
                return "Passwords don't match";
            }
            const result = await register(
                field("email"),
                field("password"),
                field("username"),
            );
            if ("error" in result) return result.error;
            location.href = "/verify-email";
            return null;
        },
    );
</script>
