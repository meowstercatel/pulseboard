---
import AuthLayout from "../layouts/AuthLayout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
import Field from "../components/Field.astro";
---

<AuthLayout title="Create account">
    <form id="register-form" method="post" novalidate>
        <Field
            id="register-email"
            label="Email"
            name="email"
            type="email"
            autocomplete="username"
        />
        <!-- a display name: you log in with the email, so it isn't "username" -->
        <Field
            id="register-username"
            label="Username (optional)"
            name="username"
            autocomplete="nickname"
        />
        <Field
            id="register-password"
            label="Password"
            name="password"
            type="password"
            autocomplete="new-password"
            helper="At least 8 characters"
            strength
        />
        <Field
            id="register-confirm"
            label="Repeat password"
            name="confirm"
            type="password"
            autocomplete="new-password"
        />
        <cds-inline-notification
            kind="error"
            title="Couldn't register"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <button class="button" type="submit" disabled>
            Create account
        </button>
    </form>
    <div id="sent" hidden>
        <p>
            Check your inbox at <strong id="sent-email"></strong>. Open the link
            we sent to finish setting up your account.
        </p>
    </div>
    <OAuthButtons />
    <p>
        By creating an account you agree to the{" "}
        <cds-link href="/terms">Terms of Service</cds-link> and acknowledge the{" "}
        <cds-link href="/privacy">Privacy Policy</cds-link>
    </p>
    <p>
        Already have an account?{" "}
        <cds-link id="login-link" href="/login">
            Log in
        </cds-link>
    </p>
</AuthLayout>

<script>
    import {
        accountDestination,
        currentUser,
        register,
        safeNext,
    } from "../lib/auth";
    import { bindForm } from "../lib/form";

    // passed on from the login page; dropped once the new account has to
    // verify its email
    const next = safeNext(new URLSearchParams(location.search).get("next"));
    if (next) {
        document
            .getElementById("login-link")!
            .setAttribute("href", `/login?${new URLSearchParams({ next })}`);
    }

    currentUser().then((user) => {
        if (user) location.replace(accountDestination(user, next));
    });

    bindForm(
        document.getElementById("register-form") as HTMLFormElement,
        async (field) => {
            if (field("password") !== field("confirm")) {
                return "Passwords don't match";
            }
            const email = field("email");
            const error = await register(
                email,
                field("password"),
                field("username"),
            );
            if (error) return error;
            document.getElementById("sent-email")!.textContent = email.trim();
            document.getElementById("register-form")!.hidden = true;
            document.getElementById("sent")!.hidden = false;
            return null;
        },
    );
</script>
