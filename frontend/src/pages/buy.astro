---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";

// Placeholder prices until real pricing is decided.
const plans = [
    {
        id: "subscription",
        name: "Subskrypcja",
        price: "19 zł",
        period: "/ miesiąc",
        note: "Odnawiana co miesiąc, możesz anulować w każdej chwili.",
        features: [
            "Wszystkie funkcje PulseBoard",
            "Aktualizacje na bieżąco",
            "Wsparcie e-mail",
        ],
        cta: "Subskrybuj",
        kind: "secondary",
    },
    {
        id: "lifetime",
        name: "Licencja dożywotnia",
        price: "199 zł",
        period: "jednorazowo",
        note: "Płacisz raz, korzystasz bez ograniczeń czasowych.",
        features: [
            "Wszystkie funkcje PulseBoard",
            "Dożywotnie aktualizacje",
            "Priorytetowe wsparcie",
        ],
        cta: "Kup licencję",
        kind: "primary",
        badge: "Najlepsza wartość",
    },
];
---

<HtmlTemplate>
    <main>
        <header>
            <h1>PulseBoard</h1>
            <p class="status">
                Licencja:
                <cds-tag id="license-status" type="red" size="md">
                    nieopłacona
                </cds-tag>
            </p>
        </header>
        <h3>Wybierz plan</h3>
        <div class="licenses">
            {plans.map((plan) => (
                <section class:list={["license", { featured: plan.badge }]}>
                    {plan.badge && (
                        <cds-tag class="badge" type="blue" size="sm">
                            {plan.badge}
                        </cds-tag>
                    )}
                    <h4>{plan.name}</h4>
                    <p class="price">
                        {plan.price} <span class="period">{plan.period}</span>
                    </p>
                    <p class="note">{plan.note}</p>
                    <ul>
                        {plan.features.map((f) => (
                            <li>{f}</li>
                        ))}
                    </ul>
                    <cds-button size="md" kind={plan.kind} data-plan={plan.id}>
                        {plan.cta}
                    </cds-button>
                </section>
            ))}
        </div>
    </main>
</HtmlTemplate>

<style>
    :global(body) {
        display: grid;
        place-items: center;
    }
    main {
        box-sizing: border-box;
        width: 100%;
        max-width: 640px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 2rem;
        box-shadow: 0px 0px 4px 2px rgba(0, 0, 0, 0.25);
    }
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    h1 {
        margin: 0;
    }
    .status {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .licenses {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1rem;
    }
    .license {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
        background: var(--cds-layer-01, #f4f4f4);
        border: 1px solid transparent;
    }
    .license.featured {
        border-color: var(--cds-border-interactive, #0f62fe);
    }
    .badge {
        position: absolute;
        top: 0;
        right: 1.25rem;
        margin: 0;
        transform: translateY(-50%);
    }
    .price {
        font-size: 2rem;
        font-weight: 600;
        line-height: 1.2;
    }
    .period {
        font-size: 0.875rem;
        font-weight: 400;
        color: var(--cds-text-secondary, #525252);
    }
    .note {
        font-size: 0.875rem;
        color: var(--cds-text-secondary, #525252);
    }
    ul {
        flex: 1;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    li {
        padding: 0.375rem 0;
        border-block-end: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 0.875rem;
    }
    li::before {
        content: "✓";
        margin-inline-end: 0.5rem;
        color: var(--cds-support-success, #24a148);
    }
    cds-button {
        width: 100%;
        max-width: none;
    }
</style>

<script>
    import "@carbon/web-components/es/components/button/index.js";
    import "@carbon/web-components/es/components/tag/index.js";
    import { purchase, requireUser } from "../lib/auth";

    const status = document.getElementById("license-status") as HTMLElement & {
        type: string;
    };

    requireUser().then((user) => {
        if (user?.licensePlan) {
            status.type = "green";
            status.textContent = "opłacona";
        }
    });

    const buttons = document.querySelectorAll<
        HTMLElement & { disabled: boolean }
    >("cds-button[data-plan]");
    for (const button of buttons) {
        button.addEventListener("click", async () => {
            const plan = button.dataset["plan"] as "subscription" | "lifetime";
            buttons.forEach((b) => (b.disabled = true));
            const result = await purchase(plan);
            if ("error" in result) {
                buttons.forEach((b) => (b.disabled = false));
                alert(result.error);
                return;
            }
            location.href = "/overview";
        });
    }
</script>
