---
import "../styles/carbon.scss";
import HtmlTemplate from "../layouts/HtmlTemplate.astro";

// Placeholder prices until real pricing is decided.
const plans = [
    {
        id: "subscription",
        name: "Subscription",
        price: "19 PLN",
        period: "/ month",
        note: "Renews monthly. Cancel anytime.",
        features: [
            "All PulseBoard features",
            "Ongoing updates",
            "Email support",
        ],
        cta: "Subscribe",
        kind: "secondary",
    },
    {
        id: "lifetime",
        name: "Lifetime license",
        price: "199 PLN",
        period: "one-time payment",
        note: "Pay once for lifetime access.",
        features: [
            "All PulseBoard features",
            "Lifetime updates",
            "Priority support",
        ],
        cta: "Buy license",
        kind: "primary",
        badge: "Best value",
    },
];
---

<HtmlTemplate>
    <main>
        <header>
            <h1>PulseBoard</h1>
            <p class="status">
                License:
                <cds-tag id="license-status" type="red" size="md">
                    unpaid
                </cds-tag>
            </p>
        </header>
        <cds-link href="/settings">Account settings</cds-link>
        <h3>Choose a plan</h3>
        <cds-checkbox
            id="waiver"
            name="withdrawalWaiver"
            invalid-text="Tick this box to continue to checkout."
        >
            I agree to immediate delivery of the digital content and acknowledge
            that I lose my 14-day right of withdrawal once delivery starts. See
            the <a href="/terms">Terms</a>.
        </cds-checkbox>
        <div class="licenses" data-locked>
            {plans.map((plan) => (
                <section class:list={["license", { featured: plan.badge }]}>
                    {plan.badge && (
                        <cds-tag class="badge" type="blue" size="sm">
                            {plan.badge}
                        </cds-tag>
                    )}
                    <h4>{plan.name}</h4>
                    <p class="price">
                        {plan.price} <span class="period">{plan.period}</span>
                    </p>
                    <p class="note">{plan.note}</p>
                    <ul>
                        {plan.features.map((f) => (
                            <li>{f}</li>
                        ))}
                    </ul>
                    <cds-button size="md" kind={plan.kind} data-plan={plan.id}>
                        {plan.cta}
                    </cds-button>
                </section>
            ))}
        </div>
        <cds-button id="manage" size="md" kind="tertiary" hidden>
            Manage subscription
        </cds-button>
        <p class="note">Payments are processed by Stripe.</p>
    </main>
</HtmlTemplate>

<style>
    :global(body) {
        display: grid;
        place-items: center;
    }
    main {
        box-sizing: border-box;
        width: 100%;
        max-width: 640px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 2rem;
        box-shadow: 0px 0px 4px 2px rgba(0, 0, 0, 0.25);
    }
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    h1 {
        margin: 0;
    }
    .status {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .licenses {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1rem;
    }
    .license {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
        background: var(--cds-layer-01, #f4f4f4);
        border: 1px solid transparent;
    }
    .license.featured {
        border-color: var(--cds-border-interactive, #0f62fe);
    }
    .badge {
        position: absolute;
        top: 0;
        right: 1.25rem;
        margin: 0;
        transform: translateY(-50%);
    }
    .price {
        font-size: 2rem;
        font-weight: 600;
        line-height: 1.2;
    }
    .period {
        font-size: 0.875rem;
        font-weight: 400;
        color: var(--cds-text-secondary, #525252);
    }
    .note {
        font-size: 0.875rem;
        color: var(--cds-text-secondary, #525252);
    }
    ul {
        flex: 1;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    li {
        padding: 0.375rem 0;
        border-block-end: 1px solid var(--cds-border-subtle, #e0e0e0);
        font-size: 0.875rem;
    }
    li::before {
        content: "✓";
        margin-inline-end: 0.5rem;
        color: var(--cds-support-success, #24a148);
    }
    cds-button {
        width: 100%;
        max-width: none;
    }
    #waiver {
        font-size: 0.875rem;
    }
    #waiver a {
        color: var(--cds-link-primary, #0f62fe);
    }
    /* dimmed but still clickable, so a click explains why */
    .licenses[data-locked] cds-button {
        filter: grayscale(1);
        opacity: 0.5;
    }
    /* the component's own display style would override the attribute */
    cds-button[hidden] {
        display: none;
    }
</style>

<script>
    import "@carbon/web-components/es/components/button/index.js";
    import "@carbon/web-components/es/components/checkbox/index.js";
    import "@carbon/web-components/es/components/tag/index.js";
    import "@carbon/web-components/es/components/link/index.js";
    import { requireVerifiedUser } from "../lib/auth";
    import { billingPortal, checkout } from "../lib/billing";

    type Button = HTMLElement & { disabled: boolean };

    const status = document.getElementById("license-status") as HTMLElement & {
        type: string;
    };
    const manage = document.getElementById("manage") as Button;
    const waiver = document.getElementById("waiver") as HTMLElement & {
        checked: boolean;
        invalid: boolean;
    };
    const buttons = document.querySelectorAll<Button>("cds-button[data-plan]");

    requireVerifiedUser().then((user) => {
        if (!user?.licensePlan) return;
        status.type = "green";
        status.textContent =
            user.licensePlan === "lifetime" ? "lifetime" : "subscription";
        for (const button of buttons) {
            const plan = button.dataset["plan"];
            // a subscriber can still upgrade to lifetime
            if (user.licensePlan === "lifetime" || plan === user.licensePlan) {
                button.disabled = true;
            }
        }
        manage.hidden = user.licensePlan !== "subscription";
    });

    // Sends the browser to a Stripe-hosted page, or shows the error.
    async function redirect(
        result: Promise<{ url: string } | { error: string }>,
        disable: Button[],
    ) {
        const before = disable.map((b) => b.disabled);
        disable.forEach((b) => (b.disabled = true));
        const res = await result;
        if ("error" in res) {
            disable.forEach((b, i) => (b.disabled = before[i]!));
            alert(res.error);
            return;
        }
        location.href = res.url;
    }

    const licenses = document.querySelector<HTMLElement>(".licenses")!;
    waiver.addEventListener("cds-checkbox-changed", () => {
        licenses.toggleAttribute("data-locked", !waiver.checked);
        if (waiver.checked) waiver.invalid = false;
    });

    for (const button of buttons) {
        button.addEventListener("click", () => {
            // the buyer must waive the right of withdrawal before checkout
            if (!waiver.checked) {
                waiver.invalid = true;
                waiver.focus();
                return;
            }
            const plan = button.dataset["plan"] as "subscription" | "lifetime";
            redirect(checkout(plan), [...buttons]);
        });
    }
    manage.addEventListener("click", () => redirect(billingPortal(), [manage]));
</script>
