---
import AuthLayout from "../layouts/AuthLayout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
import Field from "../components/Field.astro";
---

<AuthLayout title="Log in">
    <form id="login-form" method="post" novalidate>
        <Field
            id="login-email"
            label="Email"
            name="email"
            type="email"
            autocomplete="username"
        />
        <Field
            id="login-password"
            label="Password"
            name="password"
            type="password"
            autocomplete="current-password"
        />
        <p class="forgot">
            <cds-link href="/forgot-password">Forgot password?</cds-link>
        </p>
        <cds-inline-notification
            kind="error"
            title="Couldn't log in"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <button class="button" type="submit" disabled>
            Log in
        </button>
    </form>
    <OAuthButtons />
    <p>
        No account yet?{" "}
        <cds-link id="register-link" href="/register">
            Create account
        </cds-link>
    </p>
</AuthLayout>

<style>
    .forgot {
        margin-top: -0.5rem;
    }
</style>

<script>
    import {
        accountDestination,
        currentUser,
        login,
        safeNext,
    } from "../lib/auth";
    import { bindForm } from "../lib/form";

    const params = new URLSearchParams(location.search);
    // the page to return to, set by a protected page that sent us here
    const next = safeNext(params.get("next"));
    const keepNext = next ? `?${new URLSearchParams({ next })}` : "";
    document
        .getElementById("register-link")!
        .setAttribute("href", `/register${keepNext}`);

    currentUser().then((user) => {
        if (user) location.replace(accountDestination(user, next));
    });

    // Fixed messages, so a crafted link can't show its own text here
    const PROVIDER_LABELS = new Map([
        ["google", "Google"],
        ["facebook", "Facebook"],
    ]);
    const OAUTH_ERRORS = new Map<string, (label: string) => string>([
        ["cancelled", (label) => `${label} sign-in was cancelled`],
        ["expired", (label) => `${label} sign-in expired, please try again`],
        [
            "no_verified_email",
            (label) => `Your ${label} account has no verified email address`,
        ],
        [
            "email_taken",
            (label) =>
                `An account with this email already exists. Log in to it, then connect ${label} in your account settings.`,
        ],
        ["failed", (label) => `Couldn't sign in with ${label}`],
    ]);

    function oauthErrorMessage(params: URLSearchParams): string {
        const message = OAUTH_ERRORS.get(params.get("oauth_error")!);
        const label = PROVIDER_LABELS.get(params.get("provider") ?? "");
        return message && label
            ? message(label)
            : "Couldn't sign in, please try again";
    }

    // set by the server when a Google/Facebook sign-in fails
    if (params.has("oauth_error")) {
        const error = document.querySelector(
            "#login-form cds-inline-notification",
        ) as HTMLElement & { subtitle: string };
        error.subtitle = oauthErrorMessage(params);
        error.hidden = false;
        history.replaceState(null, "", `/login${keepNext}`);
    }

    bindForm(
        document.getElementById("login-form") as HTMLFormElement,
        async (field) => {
            const result = await login(field("email"), field("password"));
            if ("error" in result) return result.error;
            location.href = accountDestination(result.user, next);
            return null;
        },
    );
</script>
