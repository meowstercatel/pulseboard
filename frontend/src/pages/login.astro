---
import AuthLayout from "../layouts/AuthLayout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
---

<AuthLayout title="Log in">
    <form id="login-form">
        <cds-text-input
            label="Email"
            name="email"
            type="email"
            autocomplete="email"
        ></cds-text-input>
        <cds-text-input
            label="Password"
            name="password"
            type="password"
            show-password-visibility-toggle
            autocomplete="current-password"
        ></cds-text-input>
        <p class="forgot">
            <cds-link href="/forgot-password">Forgot password?</cds-link>
        </p>
        <cds-inline-notification
            kind="error"
            title="Couldn't log in"
            hide-close-button
            hidden
        ></cds-inline-notification>
        <cds-button>Log in</cds-button>
    </form>
    <OAuthButtons />
    <p>
        No account yet?{" "}
        <cds-link id="register-link" href="/register">
            Create account
        </cds-link>
    </p>
</AuthLayout>

<style>
    .forgot {
        margin-top: -0.5rem;
    }
</style>

<script>
    import {
        accountDestination,
        currentUser,
        login,
        safeNext,
    } from "../lib/auth";
    import { bindForm } from "../lib/form";

    const params = new URLSearchParams(location.search);
    // the page to return to, set by a protected page that sent us here
    const next = safeNext(params.get("next"));
    const keepNext = next ? `?${new URLSearchParams({ next })}` : "";
    document
        .getElementById("register-link")!
        .setAttribute("href", `/register${keepNext}`);

    currentUser().then((user) => {
        if (user) location.replace(accountDestination(user, next));
    });

    // set by the server when a Google/Facebook sign-in fails
    const oauthError = params.get("oauth_error");
    if (oauthError) {
        const error = document.querySelector(
            "#login-form cds-inline-notification",
        ) as HTMLElement & { subtitle: string };
        error.subtitle = oauthError;
        error.hidden = false;
        history.replaceState(null, "", `/login${keepNext}`);
    }

    bindForm(
        document.getElementById("login-form") as HTMLFormElement,
        async (field) => {
            const result = await login(field("email"), field("password"));
            if ("error" in result) return result.error;
            location.href = accountDestination(result.user, next);
            return null;
        },
    );
</script>
