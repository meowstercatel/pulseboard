# Requires PostgreSQL >= 15
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public origin of the site; OAuth redirect URIs are <PUBLIC_URL>/api/auth/oauth/<provider>/callback.
# Defaults to the request's origin. In local dev the Astro proxy hides that, so point it at Astro.
PUBLIC_URL="http://localhost:4321"

# Google login (https://console.cloud.google.com/apis/credentials), left out = disabled
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook login (https://developers.facebook.com/apps), left out = disabled
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Mail server for verification emails, e.g. smtp://localhost:1025 for a local mailpit.
# Left out = emails (with their verification links) are printed to the server console.
SMTP_URL=""
MAIL_FROM="PulseBoard <no-reply@pulseboard.local>"
