// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  // always store lowercased; the unique constraint is case-sensitive
  email        String   @unique
  username     String?
  passwordHash String
  licensePlan  String?
  licensedAt   TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  datasets Dataset[]
  sessions Session[]
}

model Session {
  // the session token, same value as the cookie
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId])
}

// one imported CSV file; its rows live in Metric
model Dataset {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  fileName  String?
  rowCount  Int      @default(0)
  startsAt  TimestamptzString?
  endsAt    TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  metrics Metric[]

  @@index([ownerId])
}

// one CSV row: timestamp, host, cpu_percent, ram_percent, disk_percent, net_in_mbps, net_out_mbps
model Metric {
  id          BigInt   @id @default(autoincrement())
  datasetId   Int
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  timestamp   TimestamptzString
  host        String
  cpuPercent  Float
  ramPercent  Float
  diskPercent Float
  netInMbps   Float
  netOutMbps  Float

  @@index([datasetId, timestamp])
  @@index([datasetId, host, timestamp])
}
