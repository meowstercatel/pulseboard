// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  // always store lowercased; the unique constraint is case-sensitive
  email        String   @unique
  username     String?
  // null for accounts that only sign in with Google/Facebook
  passwordHash String?
  // null until the owner clicks the link we email them (Google/Facebook sign-ins count as verified)
  emailVerifiedAt TimestamptzString?
  licensePlan  String?
  licensedAt   TimestamptzString?
  // set the first time the user opens Stripe Checkout
  stripeCustomerId     String? @unique
  // latest subscription and its Stripe status, kept in sync by the webhook
  stripeSubscriptionId String?
  subscriptionStatus   String?
  // when the user last agreed to immediate delivery and waived the 14-day right of withdrawal
  withdrawalWaiverAt   TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  datasets      Dataset[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
}

// a Google/Facebook login linked to a User, matched by the provider's user id
model OAuthAccount {
  id             Int      @id @default(autoincrement())
  // "google" or "facebook"
  provider       String
  providerUserId String
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String?
  createdAt      TimestamptzString @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  // SHA-256 (hex) of the session token; only the cookie holds the token itself
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId])
}

// a pending email verification link; only the SHA-256 of the token is stored
model EmailVerification {
  tokenHash String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the address the link was sent to, so it stops working if the user changes email
  email     String
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId])
}

// a pending password reset link; only the SHA-256 of the token is stored
model PasswordReset {
  tokenHash String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the address the link was sent to, so it stops working if the user changes email
  email     String
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId])
}

// one imported CSV file; its rows live in Metric
model Dataset {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  fileName  String?
  rowCount  Int      @default(0)
  startsAt  TimestamptzString?
  endsAt    TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  metrics Metric[]

  @@index([ownerId])
}

// one CSV row: timestamp, host, cpu_percent, ram_percent, disk_percent, net_in_mbps, net_out_mbps
model Metric {
  id          BigInt   @id @default(autoincrement())
  datasetId   Int
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  timestamp   TimestamptzString
  host        String
  cpuPercent  Float
  ramPercent  Float
  diskPercent Float
  netInMbps   Float
  netOutMbps  Float

  @@index([datasetId, timestamp])
  @@index([datasetId, host, timestamp])
}
