// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  // always store lowercased; the unique constraint is case-sensitive
  email        String   @unique
  username     String?
  passwordHash String
  licensePlan  String?
  licensedAt   TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  servers  Server[]
  sessions Session[]
}

model Session {
  // the session token, same value as the cookie
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId])
}

model Server {
  id         Int      @id @default(autoincrement())
  ownerId    Int
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  hostname   String
  ip         String?
  os         String?
  kernel     String?
  // online = lastSeenAt within the last N seconds
  lastSeenAt TimestamptzString?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([ownerId])
}
