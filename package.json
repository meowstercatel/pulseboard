{
  "name": "pulseboard",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "samples": "node scripts/generate-samples.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:typecheck": "pnpm --dir backend exec tsc -p ../tsconfig.test.json",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm run build && playwright test",
    "test:all": "pnpm run test:typecheck && pnpm test && pnpm run test:integration && pnpm run test:e2e",
    "test:services": "docker compose -f compose.test.yml up -d --wait",
    "test:services:stop": "docker compose -f compose.test.yml down",
    "build": "pnpm --dir backend run build && pnpm --dir frontend run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "happy-dom": "^21.0.4",
    "nock": "^15.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "vitest": "^5.0.5"
  }
}
